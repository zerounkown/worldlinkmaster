@using WorldLinkMaster.Web.Models
@model Category

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
@if (Model.Id != 0)
{
    <input type="hidden" asp-for="Id" />
}

<div class="mb-3">
    <label asp-for="Name" class="form-label">@Localizer["Name"]</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Slug" class="form-label">@Localizer["Slug"]</label>
    <input asp-for="Slug" class="form-control" />
    <span asp-validation-for="Slug" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label">@Localizer["Description"]</label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <div class="form-text">@Localizer["Shown under the title in this category's hero banner."]</div>
</div>
<div class="mb-3">
    <label asp-for="DescriptionAr" class="form-label">@Localizer["Description (Arabic)"]</label>
    <textarea asp-for="DescriptionAr" class="form-control" rows="3" dir="rtl"></textarea>
</div>
<div class="mb-3">
    <label asp-for="ImageUrl" class="form-label">@Localizer["Image URL"]</label>
    <input asp-for="ImageUrl" class="form-control" />
    <div class="form-text">@Localizer["Background photo for this category's hero banner. Leave blank for a plain banner."]</div>
</div>

<button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
<a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
