@using WorldLinkMaster.Web.Models
@model List<Store>
@{
    ViewData["Title"] = Localizer["Stores"];
}

<div class="d-flex justify-content-between align-items-center">
    <h1>@Localizer["Stores"]</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> @Localizer["New Store"]</a>
</div>
<p class="text-muted">@Localizer["Shown on the public \"Find a Store\" map page, in Display Order. Only Active stores appear."]</p>

<div class="table-responsive">
<table class="table bg-white align-middle mt-3">
    <thead><tr><th>@Localizer["Name"]</th><th>@Localizer["Category"]</th><th>@Localizer["Address"]</th><th>@Localizer["Order"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
    <tbody>
        @foreach (var store in Model)
        {
            <tr>
                <td>@store.Name</td>
                <td>
                    @if (store.Category == StoreCategory.OfficialStore)
                    {
                        <span class="badge bg-primary">@Localizer["Official Store"]</span>
                    }
                    else
                    {
                        <span class="badge bg-info text-dark">@Localizer["Authorized Dealer"]</span>
                    }
                </td>
                <td><small class="text-muted">@store.Address</small></td>
                <td>@store.DisplayOrder</td>
                <td>
                    @if (store.Active)
                    {
                        <span class="badge bg-success">@Localizer["Active"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Localizer["Disabled"]</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@store.Id">@Localizer["Edit"]</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@store.Id">@Localizer["Delete"]</a>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" class="text-muted">@Localizer["No stores yet. Create one to show it on the Find a Store page."]</td></tr>
        }
    </tbody>
</table>
</div>
