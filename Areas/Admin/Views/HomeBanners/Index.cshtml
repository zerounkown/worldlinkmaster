@using WorldLinkMaster.Web.Models
@model List<HomeBanner>
@{
    ViewData["Title"] = Localizer["Home Banners"];
}

<div class="d-flex justify-content-between align-items-center">
    <h1>@Localizer["Home Banners"]</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> @Localizer["New Banner"]</a>
</div>
<p class="text-muted">@Localizer["These power the rotating carousel at the very top of the homepage. Shown in Display Order; only Active banners appear."]</p>

<div class="table-responsive">
<table class="table bg-white align-middle mt-3">
    <thead><tr><th></th><th>@Localizer["Title"]</th><th>@Localizer["Order"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
    <tbody>
        @foreach (var banner in Model)
        {
            <tr>
                <td><img src="@banner.ImageUrl" alt="" style="width:90px;height:34px;object-fit:cover;border-radius:4px;" /></td>
                <td>
                    @banner.TitleEn
                    @if (!string.IsNullOrWhiteSpace(banner.SubtitleEn))
                    {
                        <br />
                        <small class="text-muted">@banner.SubtitleEn</small>
                    }
                </td>
                <td>@banner.DisplayOrder</td>
                <td>
                    @if (banner.Active)
                    {
                        <span class="badge bg-success">@Localizer["Active"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Localizer["Disabled"]</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@banner.Id">@Localizer["Edit"]</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@banner.Id">@Localizer["Delete"]</a>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-muted">@Localizer["No home banners yet. Create one to feature it on the homepage."]</td></tr>
        }
    </tbody>
</table>
</div>
