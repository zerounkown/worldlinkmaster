@using WorldLinkMaster.Web.Models.ViewModels
@model ProductImportResult
@{
    ViewData["Title"] = Localizer["Product Import"];
}

<h1>@Localizer["Product Import"]</h1>
<p class="text-muted">@Localizer["Imports Products, Product Colors, Variants, Media, and Attributes from a WLM_03_Product_Import_Template.xlsx-style workbook. Run the Master Data Import first — this references its Brand/Category/Color/Size codes."]</p>

@if (Model.HasActivity)
{
    <div class="alert @(Model.Errors.Count > 0 ? "alert-warning" : "alert-success")">
        <div class="row g-2">
            <div class="col-6 col-md-4">@Localizer["Products"]: <strong>@Model.ProductsCreated @Localizer["created"], @Model.ProductsUpdated @Localizer["updated"]</strong></div>
            <div class="col-6 col-md-4">@Localizer["Product Colors"]: <strong>@Model.ProductColorsCreated @Localizer["created"], @Model.ProductColorsUpdated @Localizer["updated"]</strong></div>
            <div class="col-6 col-md-4">@Localizer["Variants"]: <strong>@Model.VariantsCreated @Localizer["created"], @Model.VariantsUpdated @Localizer["updated"]</strong></div>
            <div class="col-6 col-md-4">@Localizer["Media rows written"]: <strong>@Model.MediaWritten</strong></div>
            <div class="col-6 col-md-4">@Localizer["Attribute rows written"]: <strong>@Model.AttributesWritten</strong></div>
        </div>

        @if (Model.Errors.Count > 0)
        {
            <div class="mt-2">
                <strong>@Localizer["{0} row(s) had a problem", Model.Errors.Count]</strong>:
                <ul class="mb-0" style="max-height: 400px; overflow-y: auto;">
                    @foreach (var error in Model.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
    </div>
}

<div class="summary-box">
    <h4>@Localizer["Upload a Product Import workbook"]</h4>
    <p>
        @Localizer["Expected sheets: Products, Product Colors, Variants, Media, Attributes — processed in that order, since each references codes/SKUs from the one before it."]
    </p>
    <p>
        @Localizer["Products and Variants are matched by Product Code / Variant SKU (existing rows are updated, new ones created). Media and Attributes have no stable row key in the sheet, so for any product that appears in those sheets, its existing media/attributes are fully replaced by what's in the file."]
    </p>
    <p class="mb-0">
        <strong>@Localizer["Note:"]</strong> @Localizer["the storefront's per-color image gallery swap (Media Rules M001-M009) isn't wired up yet — this tool gets the richer data into the database and keeps the existing product photo/gallery fields populated so pages don't look broken, but clicking a color swatch won't yet swap the gallery on the live site."]
    </p>
    <form asp-action="Import" method="post" enctype="multipart/form-data" class="d-flex gap-2 mt-3">
        <input type="file" name="file" class="form-control" accept=".xlsx" required />
        <button type="submit" class="btn btn-primary text-nowrap"><i class="bi bi-upload"></i> @Localizer["Upload"]</button>
    </form>
</div>

<a class="mt-4 d-inline-block" asp-controller="MasterData" asp-action="Index">&larr; @Localizer["Back to Master Data Import"]</a>
