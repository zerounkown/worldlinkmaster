@using WorldLinkMaster.Web.Models.ViewModels
@model BulkImportResult
@{
    ViewData["Title"] = Localizer["Bulk Update (Excel)"];
    var hasResult = Model.UpdatedCount > 0 || Model.CreatedCount > 0 || Model.VariantsUpdatedCount > 0 || Model.VariantsCreatedCount > 0 || Model.ProductColorsCreated > 0 || Model.Errors.Count > 0;
}

<h1>@Localizer["Bulk Update & Add Products (Excel)"]</h1>
<p class="text-muted">@Localizer["Update prices, wholesale prices, stock quantities, classification, and color/size variants — or add brand-new products — for many items at once. Also useful for onboarding a new supplier's catalog instead of writing SQL."]</p>

@if (!string.IsNullOrEmpty(Model.FatalError))
{
    <div class="alert alert-danger">
        <div><strong>@Model.FatalError</strong></div>

        @if (Model.Errors.Count > 0)
        {
            <div class="mt-2">
                @Localizer["Row-level problems found before the error"]:
                <ul class="mb-0">
                    @foreach (var error in Model.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
    </div>
}

@if (hasResult)
{
    <div class="alert @(Model.Errors.Count > 0 ? "alert-warning" : "alert-success")">
        <div><strong>@Localizer["{0} product(s) updated.", Model.UpdatedCount]</strong></div>
        <div><strong>@Localizer["{0} new product(s) created.", Model.CreatedCount]</strong></div>
        <div><strong>@Localizer["{0} variant(s) updated.", Model.VariantsUpdatedCount]</strong></div>
        <div><strong>@Localizer["{0} new variant(s) created.", Model.VariantsCreatedCount]</strong></div>
        @if (Model.ProductColorsCreated > 0)
        {
            <div><strong>@Localizer["{0} product color(s) backfilled from variant colors.", Model.ProductColorsCreated]</strong></div>
        }
        <div class="mt-2 text-muted small">@Localizer["Reminder: any product that has variants always has its Stock Quantity set to the sum of its variants' stock — the Products sheet's Stock Quantity value is ignored for that product."]</div>

        @if (Model.Errors.Count > 0)
        {
            <div class="mt-2">
                <strong>@Localizer["{0} row(s) had invalid data", Model.Errors.Count]</strong> (@Localizer["row skipped"]):
                <ul class="mb-0">
                    @foreach (var error in Model.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
    </div>
}

<div asp-validation-summary="All" class="text-danger"></div>

<div class="row g-4">
    <div class="col-12 col-md-6">
        <div class="summary-box">
            <h4>@Localizer["1. Download the current catalog"]</h4>
            <p>@Localizer["Get an Excel file with two sheets: Products (SKU, name, Arabic name, category, subcategory, brand, size group, price excl./incl. VAT, wholesale price excl./incl. VAT, stock, published status, image URL) and Variants (internal barcode, size, length, price excl./incl. VAT, wholesale price excl./incl. VAT, stock, image URL, per color/size combo)."]</p>
            <a class="btn btn-outline-primary" asp-action="ExportExcel"><i class="bi bi-download"></i> @Localizer["Download Products.xlsx"]</a>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="summary-box">
            <h4>@Localizer["2. Edit it, then upload it back"]</h4>
            <p class="alert alert-info py-2 px-3 mb-3">
                <strong>@Localizer["Prices, on both sheets:"]</strong>
                <strong>@Localizer["Price (AED)"]</strong> = @Localizer["before VAT"], <strong>@Localizer["Price+VAT"]</strong> = @Localizer["after 5% VAT — this is the value actually saved. The same applies to"] <strong>@Localizer["Wholesale Price (AED)"]</strong> / <strong>@Localizer["Wholesale Price+VAT"]</strong>. @Localizer["Fill in either column, or both — if both are given, they must agree (Price × 1.05 must match Price+VAT to within 0.01) or that row fails with an error and nothing is saved for it. Older files without a Price+VAT column still import correctly — their single price column is read as already including VAT, exactly as it always meant."]
            </p>
            <p>
                @Localizer["To update an existing product, keep its"] <strong>@Localizer["SKU"]</strong> @Localizer["unchanged — that's how the row is matched — and change whichever of these you need:"]
                <strong>@Localizer["Price (AED)"]</strong>/<strong>@Localizer["Price+VAT"]</strong>, <strong>@Localizer["Wholesale Price (AED)"]</strong>/<strong>@Localizer["Wholesale Price+VAT"]</strong>, <strong>@Localizer["Stock Quantity"]</strong>, <strong>@Localizer["Name (Arabic)"]</strong>, <strong>@Localizer["Brand"]</strong>, <strong>@Localizer["Subcategory"]</strong>, <strong>@Localizer["Size Group"]</strong>, @Localizer["and/or"] <strong>@Localizer["Published"]</strong>.
            </p>
            <p class="text-muted">@Localizer["A blank cell always means \"leave this unchanged\" — it never clears an existing value."]</p>
            <p>
                @Localizer["To add a brand-new product, add a new row with a SKU that doesn't exist yet, and fill in"] <strong>@Localizer["Name"]</strong>, <strong>@Localizer["Category"]</strong> (@Localizer["must exactly match an existing category name"]), <strong>@Localizer["Price (AED)"]</strong> @Localizer["and/or"] <strong>@Localizer["Price+VAT"]</strong>, <strong>@Localizer["Stock Quantity"]</strong>, @Localizer["and, ideally,"] <strong>@Localizer["Image URL"]</strong>. @Localizer["New products are unpublished (Published = No) unless the Published column says Yes, get a unique web address generated from the Name automatically, and are assigned to the default merchant."]
            </p>
            <p>
                @Localizer["Brand, Subcategory, and Size Group are matched to existing records by name only (not case-sensitive) — they are never created automatically, and an unrecognized name fails that row. A Subcategory must belong to the product's Category."]
            </p>
            <p>
                @Localizer["On the Variants sheet, keep an existing Variant Sku unchanged to update its price/stock/barcode, or add a new row with a new Variant Sku and a Product Sku (Parent) to create a new color/size combo — unknown color or size names are created automatically."]
                @Localizer["Internal Barcode, if provided, must be unique — the same barcode on two rows, or one that already belongs to a different variant, fails that row."]
            </p>
            <p>
                @Localizer["Size is the waist or main size; Length is optional. Fill both for a waist/inseam-style size (e.g. Size 28, Length 30, matching the existing \"28x30\" size — matched on the numbers, so it's never duplicated no matter which separator or case the original used). Leave Length blank for sizes that are just one value, like S/M/L or a shoe size."]
            </p>
            <p class="text-muted">
                @Localizer["For any product that has variants, its Stock Quantity is always set to the sum of its variants' stock after the import — the Products sheet's Stock Quantity value for that product is ignored."]
            </p>
            <form asp-action="BulkUpdate" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                <input type="file" name="file" class="form-control" accept=".xlsx" required />
                <button type="submit" class="btn btn-primary text-nowrap"><i class="bi bi-upload"></i> @Localizer["Upload"]</button>
            </form>
        </div>
    </div>
</div>

<a class="mt-4 d-inline-block" asp-action="Index">&larr; @Localizer["Back to Products"]</a>
