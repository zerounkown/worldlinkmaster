@using WorldLinkMaster.Web.Models
@model Product
@{
    ViewData["Title"] = Localizer["Edit Product"];
    var productColors = ViewBag.ProductColors as List<ProductColor> ?? new List<ProductColor>();
    var productMedia = ViewBag.ProductMedia as List<ProductMedia> ?? new List<ProductMedia>();
}

<h1>@Localizer["Edit Product"]</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <partial name="_Form" />
</form>

@if (productColors.Count > 0)
{
    <hr class="my-4" />
    <h2 class="h5">@Localizer["Vendor Color Codes"]</h2>
    <p class="text-muted">@Localizer["The manufacturer's own per-color code (e.g. Condor's \"002\" for Black) — used to match incoming product photos. Leave blank for colors with no known vendor code."]</p>
    <form asp-action="UpdateVendorColorCodes" asp-route-id="@Model.Id" method="post">
        <table class="table table-sm align-middle" style="max-width: 500px;">
            <thead>
                <tr>
                    <th>@Localizer["Color"]</th>
                    <th>@Localizer["Vendor Color Code"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pc in productColors)
                {
                    <tr>
                        <td>@pc.Color?.Name</td>
                        <td>
                            <input type="text" name="vendorColorCodes[@pc.Id]" value="@pc.VendorColorCode" class="form-control form-control-sm" maxlength="20" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button type="submit" class="btn btn-primary">@Localizer["Save Vendor Color Codes"]</button>
    </form>
}

@{
    // Main photos aren't shown/deletable here — the main photo is the product's primary image,
    // so removing it needs a replacement, not a bare delete; re-upload over its own filename via
    // Product Photos instead. Only "extra" (non-main) gallery photos — the "-N" suffixed ones —
    // get a thumbnail + Delete button.
    var extrasByColor = productColors
        .Select(pc => (Color: pc, Extras: productMedia.Where(m => m.ProductColorId == pc.Id && m.Active && !m.IsColorMain).OrderBy(m => m.DisplayOrder).ToList()))
        .Where(x => x.Extras.Count > 0)
        .ToList();
}
@if (extrasByColor.Count > 0)
{
    <hr class="my-4" />
    <h2 class="h5">@Localizer["Color Photos"]</h2>
    <p class="text-muted">@Localizer["Extra gallery photos for each color, uploaded via Admin -> Product Photos as \"VendorSku-ColorCode-N.ext\" (N = 2-20). The main photo has no \"-N\" and isn't shown here — replace it by re-uploading over its own filename."]</p>
    @foreach (var (color, extras) in extrasByColor)
    {
        <div class="mb-3">
            <strong>@color.Color?.Name</strong>
            <div class="d-flex flex-wrap gap-2 mt-1">
                @foreach (var media in extras)
                {
                    <div class="text-center">
                        <img src="@media.MediaUrl" alt="" class="img-thumbnail" style="width:80px;height:80px;object-fit:cover;" />
                        <form asp-area="Admin" asp-controller="ProductPhotos" asp-action="DeleteExtraPhoto" method="post" class="mt-1">
                            <input type="hidden" name="mediaId" value="@media.Id" />
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1 w-100" onclick="return confirm('@Localizer["Delete this photo?"]');">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
}
