@using WorldLinkMaster.Web.Models.ViewModels
@using Microsoft.AspNetCore.Mvc.Rendering
@model List<AdminColorRow>
@{
    ViewData["Title"] = Localizer["Manage Colors"];
    var unmappedCount = (int)ViewBag.UnmappedCount;
    var unmappedOnly = (bool)ViewBag.UnmappedOnly;
    var families = (SelectList)ViewBag.Families;
}

<div class="d-flex justify-content-between align-items-center">
    <h1>@Localizer["Colors"]</h1>
    <div>
        @if (unmappedCount > 0)
        {
            <span class="badge bg-warning text-dark me-2">@unmappedCount @Localizer["unmapped"]</span>
        }
        @if (unmappedOnly)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">@Localizer["Show all colors"]</a>
        }
        else
        {
            <a class="btn btn-outline-warning btn-sm" asp-action="Index" asp-route-unmappedOnly="true">@Localizer["Show unmapped only"]</a>
        }
    </div>
</div>

<p class="text-muted">
    @Localizer["The listing-page Color filter groups these into families. A color with no family falls back into \"Other\" until assigned here. Product pages and product-card swatches always show the specific color name, regardless of family — this only affects the filter."]
</p>

<div class="table-responsive">
<table class="table bg-white align-middle mt-3">
    <thead>
        <tr>
            <th></th>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Hex"]</th>
            <th>@Localizer["Products (variants)"]</th>
            <th>@Localizer["Products (swatch)"]</th>
            <th>@Localizer["Family"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var color in Model)
        {
            <tr class="@(color.FamilyId == null ? "table-warning" : "")">
                <td><span style="display:inline-block;width:20px;height:20px;border-radius:50%;background:@color.HexCode;border:1px solid #ccc;"></span></td>
                <td>@color.Name</td>
                <td>@color.HexCode</td>
                <td>@color.VariantProductCount</td>
                <td>@color.ProductColorCount</td>
                <td>
                    @if (color.FamilyId == null)
                    {
                        <span class="badge bg-warning text-dark">@Localizer["Unmapped"]</span>
                    }
                    else
                    {
                        @color.FamilyName
                    }
                </td>
                <td>
                    <form asp-action="AssignFamily" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@color.Id" />
                        <input type="hidden" name="unmappedOnly" value="@unmappedOnly" />
                        <select name="familyId" class="form-select form-select-sm" style="width:auto;">
                            <option value="">— @Localizer["none"] —</option>
                            @foreach (SelectListItem item in families)
                            {
                                <option value="@item.Value" selected="@(item.Value == color.FamilyId?.ToString())">@item.Text</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-primary">@Localizer["Save"]</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
