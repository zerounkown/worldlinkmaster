@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = Localizer["Forgot your password?"];
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <section class="auth-card">
            <div class="auth-card-icon">
                <i class="bi bi-key"></i>
            </div>
            <h1 class="auth-card-title">@Localizer["Forgot your password?"]</h1>
            <p class="auth-card-subtitle">@Localizer["Enter your email and we'll send you a link to reset it."]</p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">@Localizer["Email"]</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary">@Localizer["Reset password"]</button>
                </div>
                <div class="auth-card-links">
                    <p>
                        <a asp-page="./Login">@Localizer["Back to log in"]</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
