@using WorldLinkMaster.Web.Models.ViewModels
@using WorldLinkMaster.Web.Models
@using WorldLinkMaster.Web.Extensions
@model ProductListViewModel
@{
    var currentCategory = Model.Categories.FirstOrDefault(c => c.Id == Model.SelectedCategoryId);
    var currentSubcategory = currentCategory?.Subcategories.FirstOrDefault(s => Model.SelectedSubcategoryIds.Contains(s.Id));
    var selectedBrandForTitle = Model.SelectedBrandIds.Count == 1 ? Model.Brands.FirstOrDefault(b => b.Id == Model.SelectedBrandIds[0]) : null;
    ViewData["Title"] = currentSubcategory?.LocalizedName() ?? currentCategory?.LocalizedName() ?? selectedBrandForTitle?.LocalizedName() ?? Localizer["All Products"];
    var isBrowsingAllCategories = Model.SelectedCategoryId == null && Model.SelectedBrandIds.Count == 0 && string.IsNullOrWhiteSpace(Model.SearchTerm);

    // Full current filter state as a query string (minus "page") so pagination links can
    // carry every active facet forward — asp-route-* can't express repeated array params.
    var stateParams = new List<string>();
    if (Model.SelectedCategoryId.HasValue) { stateParams.Add($"categoryId={Model.SelectedCategoryId}"); }
    foreach (var id in Model.SelectedSubcategoryIds) { stateParams.Add($"subcategoryIds={id}"); }
    foreach (var id in Model.SelectedBrandIds) { stateParams.Add($"brandIds={id}"); }
    foreach (var c in Model.SelectedColors) { stateParams.Add($"colors={Uri.EscapeDataString(c)}"); }
    foreach (var s in Model.SelectedSizes) { stateParams.Add($"sizes={Uri.EscapeDataString(s)}"); }
    foreach (var id in Model.SelectedFeatureIds) { stateParams.Add($"featureIds={id}"); }
    foreach (var a in Model.SelectedAvailability) { stateParams.Add($"availability={a}"); }
    if (Model.MinRating.HasValue) { stateParams.Add($"minRating={Model.MinRating}"); }
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) { stateParams.Add($"search={Uri.EscapeDataString(Model.SearchTerm)}"); }
    if (Model.MinPrice.HasValue) { stateParams.Add($"minPrice={Model.MinPrice}"); }
    if (Model.MaxPrice.HasValue) { stateParams.Add($"maxPrice={Model.MaxPrice}"); }
    if (!string.IsNullOrWhiteSpace(Model.SortBy)) { stateParams.Add($"sort={Model.SortBy}"); }
    var filterState = string.Join("&", stateParams);

    // A category (or a subcategory within one) is selected — show the rich hero banner +
    // subcategory tile row instead of the plain text banner. Falls back gracefully: a
    // subcategory page without its own image/description uses its parent category's; a
    // category with neither renders identically to the old plain banner (no broken images).
    var showCategoryHero = currentCategory != null;
    var heroImageUrl = currentSubcategory?.ImageUrl ?? currentCategory?.ImageUrl;
    var heroDescription = currentSubcategory?.LocalizedDescription() ?? currentCategory?.LocalizedDescription();
    var heroHasImage = !string.IsNullOrWhiteSpace(heroImageUrl);
}

@if (showCategoryHero)
{
    <div class="page-banner page-banner-category @(heroHasImage ? "page-banner-category-photo" : "")" style="@(heroHasImage ? $"background-image: linear-gradient(90deg, rgba(5,5,5,0.75) 0%, rgba(5,5,5,0.45) 55%, rgba(5,5,5,0.15) 100%), url('{heroImageUrl}');" : "")">
        <div class="container-listing">
            <h1 class="category-hero-title">@(currentSubcategory?.LocalizedName() ?? currentCategory!.LocalizedName())</h1>
            @if (!string.IsNullOrWhiteSpace(heroDescription))
            {
                <p class="category-hero-description">@heroDescription</p>
            }
        </div>
    </div>

    if (currentCategory!.Subcategories.Any())
    {
        <div class="category-subcat-row">
            <div class="container-listing">
                <div class="category-subcat-grid">
                    <a class="category-subcat-tile" asp-action="Index" asp-route-categoryId="@currentCategory.Id">
                        <span class="category-subcat-tile-img-wrap">
                            @if (!string.IsNullOrWhiteSpace(currentCategory.ImageUrl))
                            {
                                <img src="@currentCategory.ImageUrl" alt="@Localizer["All {0}", currentCategory.LocalizedName()]" />
                            }
                            else
                            {
                                <span class="category-subcat-tile-placeholder"><i class="bi bi-box-seam"></i></span>
                            }
                        </span>
                        <span class="category-subcat-tile-label">@Localizer["All {0}", currentCategory.LocalizedName()]</span>
                    </a>
                    @foreach (var sub in currentCategory.Subcategories.OrderBy(s => s.DisplayOrder).ThenBy(s => s.Name))
                    {
                        <a class="category-subcat-tile" asp-action="Index" asp-route-categoryId="@currentCategory.Id" asp-route-subcategoryId="@sub.Id">
                            <span class="category-subcat-tile-img-wrap">
                                @if (!string.IsNullOrWhiteSpace(sub.ImageUrl))
                                {
                                    <img src="@sub.ImageUrl" alt="@sub.LocalizedName()" />
                                }
                                else
                                {
                                    <span class="category-subcat-tile-placeholder"><i class="bi bi-box-seam"></i></span>
                                }
                            </span>
                            <span class="category-subcat-tile-label">@sub.LocalizedName()</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="page-banner">
        <div class="container-listing">
            <h1>@(selectedBrandForTitle?.LocalizedName() ?? Localizer["All Products"])</h1>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <p class="mb-0">@Localizer["Search results for \"{0}\"", Model.SearchTerm]</p>
            }
        </div>
    </div>
}

@if (isBrowsingAllCategories)
{
    <div class="container-listing mb-3 mt-3">
        <div class="d-flex justify-content-between align-items-center">
            <a asp-controller="Categories" asp-action="Index"><i class="bi bi-grid-3x3-gap"></i> @Localizer["Browse All Collections"]</a>
            <a class="categories-quote-cta" asp-controller="QuoteRequests" asp-action="Create"><i class="bi bi-file-earmark-text"></i> @Localizer["Request a Quote"]</a>
        </div>
    </div>
}

<div class="container-listing mb-5">
    <div class="row">
        <div class="col-12 col-md-3 mb-4">
            @{
                var rangeMin = Model.PriceRangeMin;
                var rangeMax = Math.Max(Model.PriceRangeMax, rangeMin + 1);
                var currentMin = (int)Math.Round(Model.MinPrice ?? rangeMin);
                var currentMax = (int)Math.Round(Model.MaxPrice ?? rangeMax);
            }
            <form asp-action="Index" method="get" id="filterForm" class="filter-panel">
                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                <input type="hidden" name="search" value="@Model.SearchTerm" />

                <div class="filter-panel-header">
                    <h5>@Localizer["Filter Results"]</h5>
                    @if (Model.HasActiveFilters)
                    {
                        <a class="filter-clear-all" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-sort="@Model.SortBy">@Localizer["Clear All"]</a>
                    }
                </div>

                @if (currentCategory != null && Model.SubcategoryFacets.Count > 0)
                {
                    <details class="filter-accordion" open>
                        <summary class="filter-header">@Localizer["Category"] <i class="bi bi-chevron-up"></i></summary>
                        <div class="filter-body">
                            @foreach (var f in Model.SubcategoryFacets)
                            {
                                <label class="filter-checkbox-row">
                                    <input type="checkbox" name="subcategoryIds" value="@f.Id" checked="@(Model.SelectedSubcategoryIds.Contains(f.Id) ? "checked" : null)" />
                                    <span>@f.LocalizedName()</span>
                                    <span class="filter-count">(@f.Count)</span>
                                </label>
                            }
                        </div>
                    </details>
                }

                @if (Model.BrandFacets.Count > 0)
                {
                    <details class="filter-accordion" open>
                        <summary class="filter-header">@Localizer["Brand"] <i class="bi bi-chevron-up"></i></summary>
                        <div class="filter-body" id="brandFacetList">
                            @{ var brandRow = 0; }
                            @foreach (var f in Model.BrandFacets)
                            {
                                brandRow++;
                                <label class="filter-checkbox-row @(brandRow > 5 ? "filter-extra" : "")">
                                    <input type="checkbox" name="brandIds" value="@f.Id" checked="@(Model.SelectedBrandIds.Contains(f.Id) ? "checked" : null)" />
                                    <span>@f.LocalizedName()</span>
                                    <span class="filter-count">(@f.Count)</span>
                                </label>
                            }
                            @if (Model.BrandFacets.Count > 5)
                            {
                                <button type="button" class="filter-show-more" data-target="brandFacetList" data-show-less="@Localizer["Show less"]">@Localizer["Show more"]</button>
                            }
                        </div>
                    </details>
                }

                @if (Model.ColorFacets.Count > 0)
                {
                    <details class="filter-accordion" open>
                        <summary class="filter-header">@Localizer["Color"] <i class="bi bi-chevron-up"></i></summary>
                        <div class="filter-body filter-swatch-row">
                            @foreach (var c in Model.ColorFacets)
                            {
                                var isColorSelected = Model.SelectedColors.Contains(c.Name);
                                <label class="filter-swatch @(isColorSelected ? "active" : "")" style="--swatch-color: @c.HexCode" title="@c.Name (@c.Count)">
                                    <input type="checkbox" name="colors" value="@c.Name" checked="@(isColorSelected ? "checked" : null)" />
                                </label>
                            }
                        </div>
                    </details>
                }

                <details class="filter-accordion" open>
                    <summary class="filter-header">@Localizer["Price"] (@WorldLinkMaster.Web.Services.CurrencyContext.Current) <i class="bi bi-chevron-up"></i></summary>
                    <div class="filter-body">
                        <div class="price-range-slider" data-range-min="@rangeMin" data-range-max="@rangeMax">
                            <div class="price-range-track">
                                <div class="price-range-fill"></div>
                            </div>
                            <input type="range" class="price-range-input price-range-input-min" min="@rangeMin" max="@rangeMax" value="@currentMin" aria-label="@Localizer["Min"]" />
                            <input type="range" class="price-range-input price-range-input-max" min="@rangeMin" max="@rangeMax" value="@currentMax" aria-label="@Localizer["Max"]" />
                        </div>
                        <div class="price-range-values">
                            <input type="number" id="minPriceInput" name="minPrice" min="@rangeMin" max="@rangeMax" value="@currentMin" aria-label="@Localizer["Min"]" />
                            <input type="number" id="maxPriceInput" name="maxPrice" min="@rangeMin" max="@rangeMax" value="@currentMax" aria-label="@Localizer["Max"]" />
                        </div>
                    </div>
                </details>

                @if (Model.SizeFacets.Count > 0)
                {
                    <details class="filter-accordion">
                        <summary class="filter-header">@Localizer["Size / Capacity"] <i class="bi bi-chevron-down"></i></summary>
                        <div class="filter-body">
                            @foreach (var s in Model.SizeFacets)
                            {
                                <label class="filter-checkbox-row">
                                    <input type="checkbox" name="sizes" value="@s.Label" checked="@(Model.SelectedSizes.Contains(s.Label) ? "checked" : null)" />
                                    <span>@s.Label</span>
                                    <span class="filter-count">(@s.Count)</span>
                                </label>
                            }
                        </div>
                    </details>
                }

                @if (Model.FeatureFacets.Count > 0)
                {
                    <details class="filter-accordion">
                        <summary class="filter-header">@Localizer["Features"] <i class="bi bi-chevron-down"></i></summary>
                        <div class="filter-body">
                            @foreach (var f in Model.FeatureFacets)
                            {
                                <label class="filter-checkbox-row">
                                    <input type="checkbox" name="featureIds" value="@f.Id" checked="@(Model.SelectedFeatureIds.Contains(f.Id) ? "checked" : null)" />
                                    <span>@f.LocalizedName()</span>
                                    <span class="filter-count">(@f.Count)</span>
                                </label>
                            }
                        </div>
                    </details>
                }

                @if (Model.InStockCount > 0 || Model.OutOfStockCount > 0)
                {
                    <details class="filter-accordion">
                        <summary class="filter-header">@Localizer["Availability"] <i class="bi bi-chevron-down"></i></summary>
                        <div class="filter-body">
                            <label class="filter-checkbox-row">
                                <input type="checkbox" name="availability" value="in-stock" checked="@(Model.SelectedAvailability.Contains("in-stock") ? "checked" : null)" />
                                <span>@Localizer["In Stock"]</span>
                                <span class="filter-count">(@Model.InStockCount)</span>
                            </label>
                            <label class="filter-checkbox-row">
                                <input type="checkbox" name="availability" value="out-of-stock" checked="@(Model.SelectedAvailability.Contains("out-of-stock") ? "checked" : null)" />
                                <span>@Localizer["Out of Stock"]</span>
                                <span class="filter-count">(@Model.OutOfStockCount)</span>
                            </label>
                        </div>
                    </details>
                }

                <details class="filter-accordion">
                    <summary class="filter-header">@Localizer["Rating"] <i class="bi bi-chevron-down"></i></summary>
                    <div class="filter-body">
                        @for (var stars = 4; stars >= 1; stars--)
                        {
                            <label class="filter-radio-row">
                                <input type="radio" name="minRating" value="@stars" checked="@(Model.MinRating == stars ? "checked" : null)" />
                                <span class="filter-stars">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= stars ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                </span>
                                <span class="filter-count">@Localizer["& up"] (@Model.RatingCounts.GetValueOrDefault(stars))</span>
                            </label>
                        }
                    </div>
                </details>
            </form>
        </div>
        <div class="col-12 col-md-9">
            @if (currentCategory != null)
            {
                <!-- Category page details — Step 3: clear CTA per category -->
                <div class="category-cta-banner">
                    <span><i class="bi bi-file-earmark-text"></i> @Localizer["Buying {0} in bulk?", currentCategory.LocalizedName()]</span>
                    <a asp-controller="QuoteRequests" asp-action="Create">@Localizer["Request a Quote"] <i class="bi bi-arrow-right"></i></a>
                </div>
            }

            <div class="sort-bar">
                <span class="sort-bar-count">@Localizer["{0} product(s)", Model.TotalCount]</span>
                <label for="sortSelect">@Localizer["Sort by"]</label>
                <select name="sort" id="sortSelect" form="filterForm" onchange="document.getElementById('filterForm').requestSubmit()">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">@Localizer["Name (A-Z)"]</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">@Localizer["Price: Low to High"]</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">@Localizer["Price: High to Low"]</option>
                    <option value="newest" selected="@(Model.SortBy == "newest")">@Localizer["Newest"]</option>
                    <option value="rating" selected="@(Model.SortBy == "rating")">@Localizer["Top Rated"]</option>
                </select>
            </div>

            @if (currentCategory != null && currentCategory.Slug == "bags-and-packs")
            {
                var bagSubcategories = currentCategory.Subcategories.Where(s => !string.IsNullOrWhiteSpace(s.ImageUrl)).ToList();
                if (bagSubcategories.Count > 0)
                {
                    <div class="subcat-tile-row">
                        @foreach (var subcategory in bagSubcategories)
                        {
                            var isSubcategoryActive = Model.SelectedSubcategoryIds.Contains(subcategory.Id);
                            <a class="subcat-tile @(isSubcategoryActive ? "active" : "")" asp-action="Index" asp-route-categoryId="@currentCategory.Id" asp-route-subcategoryId="@subcategory.Id">
                                <span class="subcat-tile-img"><img src="@subcategory.ImageUrl" alt="@subcategory.LocalizedName()" /></span>
                                <span class="subcat-tile-label">@subcategory.LocalizedName()</span>
                            </a>
                        }
                    </div>
                }
            }

            @if (Model.Products.Count == 0)
            {
                <p>@Localizer["No products found. Try a different category or search term."]</p>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var product in Model.Products)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav>
                        <ul class="pagination">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" href="?@filterState&page=@i">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
