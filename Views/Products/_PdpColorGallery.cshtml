@using WorldLinkMaster.Web.Models
@using WorldLinkMaster.Web.Extensions
@model Product
@{
    // Gallery: thumbnails + main image only — color selection lives in the buy-box column
    // (see Details.cshtml, the hasProductColors swatch block), not here. Scoped to multi-color
    // products only (Details.cshtml only renders this partial when Model.ProductColors.Count > 1);
    // single-color products use the near-identical inline markup directly in Details.cshtml.
    //
    // One combined, always-present strip: the fixed one-photo-per-color list (colorThumbItems)
    // first, then the shared/detail photos (sharedGalleryItems) appended after — never rebuilt
    // when the customer picks a different color (renderGallery in product-gallery.js only
    // touches the color portion; shared items are marked data-shared="1" so it knows to leave
    // them alone). The toggle button scrolls between the two portions; it doesn't hide/show
    // anything — see #thumbsStripToggle in product-gallery.js.
    var colorThumbItems = (List<Dictionary<string, string?>>)ViewData["ColorThumbItems"]!;
    var sharedGalleryItems = (List<Dictionary<string, string?>>)ViewData["SharedGalleryItems"]!;
    var defaultProductColor = Model.ProductColors.FirstOrDefault(pc => pc.DefaultColor) ?? Model.ProductColors.First();

    var initialGallery = colorThumbItems.Count > 0 ? colorThumbItems : new List<Dictionary<string, string?>>
    {
        new() { ["type"] = "Image", ["url"] = ImagePlaceholder.DataUri, ["thumb"] = ImagePlaceholder.DataUri, ["alt"] = null }
    };

    var initialActiveIndex = initialGallery.FindIndex(item => item.GetValueOrDefault("colorId") == defaultProductColor.Id.ToString());
    if (initialActiveIndex < 0) { initialActiveIndex = 0; }
    var firstItem = initialGallery[initialActiveIndex];
    var firstIsVideo = firstItem["type"] == "Video";
}
<div class="pdp-gallery-panel">
    <div class="product-gallery-layout">
        @{
            // Caps the visible window to "all of this product's own colors, plus a deliberate
            // partial peek of the next photo" rather than an arbitrary fixed height — a 2-color
            // product and a 7-color product both need a different cutoff to achieve the same
            // "peek" effect. See --thumb-count in site.css.
            var thumbsWrapStyle = sharedGalleryItems.Count > 0 ? $"--thumb-count: {colorThumbItems.Count};" : null;
        }
        <div class="product-thumbs-wrap" id="productThumbsWrap" style="@thumbsWrapStyle">
            <div class="product-thumbs" id="productThumbs">
                @for (int i = 0; i < initialGallery.Count; i++)
                {
                    var item = initialGallery[i];
                    var isVideo = item["type"] == "Video";
                    <span class="product-thumb-item">
                        <img src="@(item["thumb"] ?? ImagePlaceholder.DataUri)"
                             class="product-thumb @(i == initialActiveIndex ? "active" : "")"
                             data-full="@item["url"]" data-type="@item["type"]" data-color-id="@item.GetValueOrDefault("colorId")"
                             alt="@(item["alt"] ?? Model.LocalizedName())" />
                        @if (isVideo)
                        {
                            <i class="bi bi-play-circle-fill product-thumb-play"></i>
                        }
                    </span>
                }
                @for (int i = 0; i < sharedGalleryItems.Count; i++)
                {
                    var item = sharedGalleryItems[i];
                    var isVideo = item["type"] == "Video";
                    <span class="product-thumb-item" data-shared="1">
                        <img src="@(item["thumb"] ?? ImagePlaceholder.DataUri)"
                             class="product-thumb" id="@(i == 0 ? "firstSharedThumb" : null)"
                             data-full="@item["url"]" data-type="@item["type"]"
                             alt="@(item["alt"] ?? Model.LocalizedName())" />
                        @if (isVideo)
                        {
                            <i class="bi bi-play-circle-fill product-thumb-play"></i>
                        }
                    </span>
                }
            </div>
            @if (sharedGalleryItems.Count > 0)
            {
                <div class="product-thumbs-toggle-row">
                    <button type="button" class="product-thumbs-toggle-btn" id="thumbsToggleDown" aria-label="@Localizer["Show more photos"]">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <button type="button" class="product-thumbs-toggle-btn" id="thumbsToggleUp" aria-label="@Localizer["Back to colors"]" disabled>
                        <i class="bi bi-chevron-up"></i>
                    </button>
                </div>
            }
        </div>
        <div class="product-zoom-container" id="zoomContainer">
            <img src="@(firstIsVideo ? (firstItem["thumb"] ?? ImagePlaceholder.DataUri) : firstItem["url"])" alt="@Model.LocalizedName()" class="product-zoom-image" id="mainProductImage" style="@(firstIsVideo ? "display:none;" : "")" />
            <video id="mainProductVideo" controls class="product-zoom-video" style="@(firstIsVideo ? "" : "display:none;")">
                @if (firstIsVideo)
                {
                    <source src="@firstItem["url"]" />
                }
            </video>
            <span class="zoom-hint"><i class="bi bi-zoom-in"></i> @Localizer["Hover to zoom · Click to enlarge"]</span>
        </div>
    </div>
</div>
