@using System.Text.Json
@using WorldLinkMaster.Web.Models
@using WorldLinkMaster.Web.Models.ViewModels
@using WorldLinkMaster.Web.Extensions
@using WorldLinkMaster.Web.Services
@inject IFavoriteService FavoriteService
@inject ICompareService CompareService
@model Product
@{
    ViewData["Title"] = Model.LocalizedName();
    var related = ViewBag.Related as List<Product> ?? new List<Product>();
    var productReviews = ViewBag.Reviews as List<ProductReviewDisplay> ?? new List<ProductReviewDisplay>();
    var myReview = ViewBag.MyReview as ProductReview;
    var isArabicUi = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";

    // Products brought in through the Product Importer have real per-color Media (Media Rules
    // M001-M009 in WLM_01_Developer_Specification.xlsx); everything else falls back to the
    // original single flat gallery (Product.ImageUrl + ProductImages) exactly as before.
    var hasProductColors = Model.ProductColors.Count > 0;

    var gallery = new List<string>();
    if (!string.IsNullOrEmpty(Model.ImageUrl)) { gallery.Add(Model.ImageUrl); }
    gallery.AddRange(Model.Images.Select(i => i.ImageUrl));
    if (gallery.Count == 0) { gallery.Add(ImagePlaceholder.DataUri); }

    var activeEvent = ViewBag.ActiveEvent as PromoEvent;
    var salePrice = activeEvent != null ? Model.Price * (1 - activeEvent.DiscountPercent / 100m) : (decimal?)null;
    var detailIsFavorite = User.Identity?.IsAuthenticated == true && await FavoriteService.IsFavoriteAsync(Model.Id);
    var detailIsInCompare = User.Identity?.IsAuthenticated == true && await CompareService.IsInCompareAsync(Model.Id);

    // Live quantity × price total (Views/Shared js below) — the unit price is already
    // resolved to whatever currency the shopper is viewing the store in.
    var effectiveUnitPrice = (salePrice ?? Model.Price).ToDisplayCurrencyValue();
    var currencySymbol = CurrencyContext.Current == "USD" ? "$" : "AED ";

    // Distinct colors/sizes offered across this product's variants, each paired with a
    // representative variant image (falls back to the main product photo when none is set).
    // Used for the swatches/cart form on legacy (non-imported) products.
    var colorOptions = Model.Variants
        .Where(v => v.ColorId.HasValue)
        .GroupBy(v => v.ColorId!.Value)
        .Select(g => (Color: g.First().Color!, ImageUrl: g.Select(v => v.ImageUrl).FirstOrDefault(ImagePlaceholder.IsRealImageUrl)))
        .ToList();
    var sizeOptions = Model.Variants
        .Where(v => v.SizeId.HasValue)
        .GroupBy(v => v.SizeId!.Value)
        .Select(g => g.First().Size!)
        .OrderBy(s => s.SortOrder)
        .ToList();

    // Lets product-card swatches, the cart drawer/page, and the "Back to product" link all
    // deep-link straight to a specific color via ?color=Name — e.g. hovered/tapped a swatch, then
    // clicked through, or came back from the cart for the color they just added. Falls back to
    // the normal DefaultColor/first-color logic when absent or the name doesn't match any of this
    // product's colors. Shared by both the imported (hasProductColors) and legacy color pickers
    // below, so it works the same way regardless of which one a given product uses.
    var requestedColorName = Context.Request.Query["color"].ToString();

    // --- New per-color gallery (only meaningful when hasProductColors) ---
    ProductColor? defaultProductColor = null;
    Dictionary<int, List<Dictionary<string, string?>>> galleryByColorId = new();
    List<Dictionary<string, string?>> initialGallery = new();
    List<Dictionary<string, string?>> colorThumbItems = new();
    List<Dictionary<string, string?>> sharedGalleryItems = new();

    if (hasProductColors)
    {
        defaultProductColor = (!string.IsNullOrEmpty(requestedColorName)
                ? Model.ProductColors.FirstOrDefault(pc => string.Equals(pc.Color?.Name, requestedColorName, StringComparison.OrdinalIgnoreCase))
                : null)
            ?? Model.ProductColors.FirstOrDefault(pc => pc.DefaultColor)
            ?? Model.ProductColors.First();

        var sharedItems = Model.Media
            .Where(m => m.ProductColorId == null && m.MediaScope == "Shared" && m.ShowInGallery && ImagePlaceholder.IsRealImageUrl(m.MediaUrl))
            .OrderBy(m => m.DisplayOrder)
            .ToList();

        // Fallback source for products whose ProductColors/ProductMedia gallery has no real
        // photo at all for a color (e.g. the Condor catalog cleanup, which sourced real images
        // into the legacy ProductVariants.ImageUrl per color but never backfilled the newer
        // ProductMedia rows — those are still seeded with the pending-placeholder string).
        var variantImageByColorId = Model.Variants
            .Where(v => v.ColorId.HasValue && ImagePlaceholder.IsRealImageUrl(v.ImageUrl))
            .GroupBy(v => v.ColorId!.Value)
            .ToDictionary(g => g.Key, g => g.First().ImageUrl);

        // Maps a media URL back to the ProductColor it represents (its own main/first photo,
        // or swatch image) — this lets a gallery thumbnail be traced back to a specific color
        // swatch even when the thumbnail came from Shared media, so clicking a thumbnail can
        // select the matching color button and keep the two controls in sync.
        //
        // Also builds colorThumbItems: exactly one representative (front/IsColorMain) photo per
        // color, fixed regardless of which color is selected. The left gallery panel for
        // multi-color products always shows these Model.ProductColors.Count items — no per-color
        // angle swapping — with clicking one selecting that color, same as the swatches above
        // Size. (This intentionally diverges from Media Rules M002/M003 for the Count > 1 case;
        // single-color products are untouched and keep full multi-angle browsing below.)
        var colorIdByUrl = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var pc in Model.ProductColors)
        {
            var ownMedia = Model.Media
                .Where(m => m.ProductColorId == pc.Id && m.ShowInGallery && ImagePlaceholder.IsRealImageUrl(m.MediaUrl))
                .OrderByDescending(m => m.IsColorMain)
                .ThenBy(m => m.DisplayOrder)
                .FirstOrDefault();
            var ownUrl = ownMedia?.MediaUrl
                ?? (ImagePlaceholder.IsRealImageUrl(pc.SwatchImageUrl) ? pc.SwatchImageUrl : null)
                ?? (variantImageByColorId.TryGetValue(pc.ColorId, out var thumbFallbackUrl) ? thumbFallbackUrl : null)
                ?? (ImagePlaceholder.IsRealImageUrl(Model.ImageUrl) ? Model.ImageUrl : null);
            if (!string.IsNullOrEmpty(ownUrl) && !colorIdByUrl.ContainsKey(ownUrl))
            {
                colorIdByUrl[ownUrl] = pc.Id;
            }

            colorThumbItems.Add(new Dictionary<string, string?>
            {
                ["type"] = ownMedia?.MediaType ?? "Image",
                ["url"] = ownUrl ?? ImagePlaceholder.DataUri,
                ["thumb"] = ownMedia?.ThumbnailUrl ?? ownUrl ?? ImagePlaceholder.DataUri,
                ["alt"] = pc.Color?.Name,
                ["colorId"] = pc.Id.ToString()
            });
        }

        Dictionary<string, string?> ToGalleryItem(ProductMedia m) => new()
        {
            ["type"] = m.MediaType,
            ["url"] = m.MediaUrl,
            ["thumb"] = m.ThumbnailUrl ?? (m.MediaType == "Image" ? m.MediaUrl : null),
            ["alt"] = isArabicUi ? (m.AltTextAr ?? m.AltTextEn) : (m.AltTextEn ?? m.AltTextAr),
            ["colorId"] = colorIdByUrl.TryGetValue(m.MediaUrl, out var mediaColorId) ? mediaColorId.ToString() : null
        };

        // Fixed additional-images strip (pocket/back/side/detail shots common to every color) —
        // shown below the color thumbnails in the multi-color gallery panel, never rebuilt on
        // color change. Reuses the same Shared-scope media the per-color angle lists already
        // fold in (see "combined" below) — this is a second, separate view onto the same rows.
        sharedGalleryItems = sharedItems.Select(ToGalleryItem).ToList();

        foreach (var pc in Model.ProductColors)
        {
            var colorItems = Model.Media
                .Where(m => m.ProductColorId == pc.Id && m.ShowInGallery && ImagePlaceholder.IsRealImageUrl(m.MediaUrl))
                .OrderBy(m => m.DisplayOrder);
            // Color's own items first (front → side → back, per DisplayOrder), Shared items
            // (fabric/detail close-ups common to every color) appended at the end — so the
            // gallery always opens on this color's own front view, not a generic shared photo.
            var combined = colorItems.Concat(sharedItems).Select(ToGalleryItem).ToList();
            if (combined.Count == 0 && ImagePlaceholder.IsRealImageUrl(pc.SwatchImageUrl))
            {
                combined.Add(new Dictionary<string, string?> { ["type"] = "Image", ["url"] = pc.SwatchImageUrl, ["thumb"] = pc.SwatchImageUrl, ["alt"] = pc.Color?.Name, ["colorId"] = pc.Id.ToString() });
            }
            if (combined.Count == 0)
            {
                var fallbackUrl = variantImageByColorId.TryGetValue(pc.ColorId, out var vUrl) ? vUrl
                    : (ImagePlaceholder.IsRealImageUrl(Model.ImageUrl) ? Model.ImageUrl : null);
                if (fallbackUrl != null)
                {
                    combined.Add(new Dictionary<string, string?> { ["type"] = "Image", ["url"] = fallbackUrl, ["thumb"] = fallbackUrl, ["alt"] = pc.Color?.Name, ["colorId"] = pc.Id.ToString() });
                }
            }

            // Defensive fallback: color items are ordered first above, so this color's own photo
            // is normally already at index 0 and no explicit "active" flag is needed (the
            // Razor/JS default-to-0 logic already covers that). This only matters if a color has
            // no gallery items of its own at all (Shared-only, e.g. via the SwatchImageUrl/
            // variant-image fallbacks above) — then its own item won't land at index 0 naturally.
            var ownIndex = combined.FindIndex(item => item.GetValueOrDefault("colorId") == pc.Id.ToString());
            if (ownIndex > 0)
            {
                combined[ownIndex]["active"] = "1";
            }

            galleryByColorId[pc.Id] = combined;
        }

        initialGallery = galleryByColorId.GetValueOrDefault(defaultProductColor.Id, new());
        if (initialGallery.Count == 0)
        {
            initialGallery.Add(new Dictionary<string, string?> { ["type"] = "Image", ["url"] = ImagePlaceholder.DataUri, ["thumb"] = ImagePlaceholder.DataUri, ["alt"] = null });
        }
    }

    var galleryDataJson = JsonSerializer.Serialize(galleryByColorId);
    var colorThumbItemsJson = JsonSerializer.Serialize(colorThumbItems);

    // --- Per-color size list (only meaningful when hasProductColors) — sizes must be scoped
    // to the selected color's own variants, not the product's whole variant set, or colors that
    // happen to share size labels (S/M/L, 30/32/34, ...) show every size from every color mixed
    // together instead of just what that color actually offers.
    List<Size> SizesForColor(int productColorId) => Model.Variants
        .Where(v => v.ProductColorId == productColorId && v.SizeId.HasValue)
        .GroupBy(v => v.SizeId!.Value)
        .Select(g => g.First().Size!)
        .OrderBy(s => s.SortOrder)
        .ToList();

    Dictionary<int, List<string>> sizesByColorId = new();
    var initialSizeOptions = sizeOptions;
    if (hasProductColors)
    {
        foreach (var pc in Model.ProductColors)
        {
            sizesByColorId[pc.Id] = SizesForColor(pc.Id).Select(s => s.Label).ToList();
        }
        initialSizeOptions = SizesForColor(defaultProductColor!.Id);
    }

    var sizeDataJson = JsonSerializer.Serialize(sizesByColorId);

    // Presentation-only Size/Length split (Media Rules aside — this is a display convenience,
    // not a schema change): only for Size Groups whose Label is a clean, 100%-consistent
    // "<number><letter(s)>" pattern across every size in the catalog today (Women's R-Sizes —
    // "4R".."12R" — and Flight Suit chest/height — "34R".."48L"). Deliberately excludes
    // Trouser Waist×Length and Clothing Letter sizes, both of which have accumulated
    // inconsistent labels (plain letters, "X - Long" suffixes, a blank label) that a blind
    // split would misparse — those need a data cleanup pass before this can safely extend to
    // them. The split itself never touches the underlying Size row or variant lookup: the two
    // pickers recombine into the exact same label string ("4"+"R"="4R") that already round-trips
    // through sizesByColorId/variantSkuByKey above, so the hidden `size` form field — and
    // everything downstream of it (CartController matches by Size.Label) — is unchanged.
    var splitSizeGroupCodes = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "WMN-R", "FLT-SUIT" };
    var productSizeGroupCode = Model.Variants.Select(v => v.Size?.SizeGroup?.Code).FirstOrDefault(c => c != null);
    var isSplitSizeProduct = productSizeGroupCode != null && splitSizeGroupCodes.Contains(productSizeGroupCode);

    (string Unit, string Length) DecomposeSize(string label)
    {
        var match = System.Text.RegularExpressions.Regex.Match(label, @"^(\d+)([A-Za-z]+)$");
        return match.Success ? (match.Groups[1].Value, match.Groups[2].Value.ToUpperInvariant()) : (label, "");
    }

    int LengthSortRank(string length) => length switch { "S" => 0, "R" => 1, "L" => 2, _ => 3 };

    // --- Waist × Length split ("28x30" style labels) ---
    // A separate mechanism from the letter-suffix split above: different Size Group ("TR-WL"),
    // and a deliberately separator-agnostic parser — production data currently uses an ASCII "x"
    // between the two numbers, but nothing here assumes that specific character; matching on
    // "any run of non-digit characters" instead means a stray "×", "-", or space in the source
    // data still parses correctly instead of silently failing to split.
    //
    // Gated per-PRODUCT, not per-group: the TR-WL Size Group also holds several older,
    // inconsistently-labeled size families (plain numbers, "N - Long" suffixes, letter sizes) from
    // past imports that don't fit this pattern at all — this only activates when every single size
    // this product actually offers matches cleanly, so a future product sharing the messy group
    // falls back to the ordinary flat size row instead of rendering broken chips.
    //
    // The interaction model is also different from the letter-suffix split: both axes always show
    // every value that exists anywhere for the selected color (never trimmed to a subset), and a
    // combination that doesn't exist or has no stock is rendered disabled + struck-through instead
    // of being removed — see buildWaistLengthRow in product-gallery.js. Like the letter-suffix
    // split, this never touches the underlying Size row: each combo's ORIGINAL Size.Label (never a
    // reconstructed "waist+separator+length" string) is what ends up in the hidden `size` field, so
    // CartController's Size.Label lookup — and everything downstream of it — is unchanged.
    var waistLengthRegex = new System.Text.RegularExpressions.Regex(@"^(\d+)\D+(\d+)$");
    var isWaistLengthSplitProduct = productSizeGroupCode == "TR-WL"
        && sizeOptions.Count > 0
        && sizeOptions.All(s => waistLengthRegex.IsMatch(s.Label));

    (string Waist, string Length) DecomposeWaistLength(string label)
    {
        var match = waistLengthRegex.Match(label);
        return match.Success ? (match.Groups[1].Value, match.Groups[2].Value) : (label, "");
    }

    int NumericSortRank(string value) => int.TryParse(value, out var n) ? n : int.MaxValue;

    int StockFor(Dictionary<string, (string Label, int Stock)> combos, string key) =>
        combos.TryGetValue(key, out var combo) ? combo.Stock : 0;

    var waistsByColorId = new Dictionary<int, List<string>>();
    var lengthsByColorId = new Dictionary<int, List<string>>();
    var waistLengthComboByColorId = new Dictionary<int, Dictionary<string, (string Label, int Stock)>>();
    var initialWaist = "";
    var initialLength = "";

    if (isWaistLengthSplitProduct && hasProductColors)
    {
        foreach (var pc in Model.ProductColors)
        {
            var combos = new Dictionary<string, (string Label, int Stock)>();
            foreach (var v in Model.Variants.Where(v => v.ProductColorId == pc.Id && v.SizeId.HasValue))
            {
                var (waist, length) = DecomposeWaistLength(v.Size!.Label);
                combos[$"{waist}|{length}"] = (v.Size.Label, v.StockQuantity);
            }
            waistLengthComboByColorId[pc.Id] = combos;
            waistsByColorId[pc.Id] = combos.Keys.Select(k => k.Split('|')[0]).Distinct().OrderBy(NumericSortRank).ToList();
            lengthsByColorId[pc.Id] = combos.Keys.Select(k => k.Split('|')[1]).Distinct().OrderBy(NumericSortRank).ToList();
        }

        // Default to the first waist that has at least one in-stock length, then the first
        // in-stock length for that waist — falls back to the very first combo at all if nothing
        // is in stock (the page's own "Out of Stock" messaging is driven separately by the
        // aggregate Model.StockQuantity, not this picker).
        var defaultColorId = defaultProductColor!.Id;
        var defaultCombos = waistLengthComboByColorId.GetValueOrDefault(defaultColorId, new());
        var defaultWaists = waistsByColorId.GetValueOrDefault(defaultColorId, new());
        var defaultLengths = lengthsByColorId.GetValueOrDefault(defaultColorId, new());
        initialWaist = defaultWaists.FirstOrDefault(w => defaultLengths.Any(l => StockFor(defaultCombos, $"{w}|{l}") > 0))
            ?? defaultWaists.FirstOrDefault() ?? "";
        initialLength = defaultLengths.FirstOrDefault(l => StockFor(defaultCombos, $"{initialWaist}|{l}") > 0)
            ?? defaultLengths.FirstOrDefault() ?? "";
    }

    // System.Text.Json serializes a ValueTuple by its Item1/Item2 field names, not the "Label"/
    // "Stock" names used above for readability — projected to an anonymous type here so the JSON
    // actually matches what product-gallery.js reads (combo.label / combo.stock).
    var waistLengthComboDataJson = JsonSerializer.Serialize(
        waistLengthComboByColorId.ToDictionary(
            outer => outer.Key,
            outer => outer.Value.ToDictionary(inner => inner.Key, inner => new { label = inner.Value.Label, stock = inner.Value.Stock })));

    // Maps "<colorKey>|<sizeLabel>" to that specific ProductVariant's Sku, so the SKU line can
    // follow whichever variant is currently selected instead of always showing the parent
    // Product.Sku. colorKey is the ProductColor.Id for imported products (matching the color
    // swatches' data-color-id above) or the shared Color.Id for legacy products (colorOptions) —
    // either half of the key is "" when the product has no color/size dimension at all. Grouped
    // rather than a plain ToDictionary since nothing at the DB level guarantees a variant is
    // unique per (ProductColorId, SizeId) the way it is per (ColorId, SizeId).
    var variantSkuByKey = Model.Variants
        .GroupBy(v => (hasProductColors ? v.ProductColorId?.ToString() : v.ColorId?.ToString()) + "|" + (v.Size?.Label ?? ""))
        .ToDictionary(g => g.Key, g => g.First().Sku);

    // Same key shape as variantSkuByKey — a variant's own Price (when set) overrides the
    // product's base price (e.g. one colorway priced differently), but the displayed price and
    // the quantity-total calculation only ever read Model.Price and never updated on color/size
    // change. price is pre-formatted to the shopper's display currency and already has any
    // active sale discount applied, exactly like _ProductCard.cshtml's quick-add variants do.
    var variantPriceByKey = Model.Variants
        .GroupBy(v => (hasProductColors ? v.ProductColorId?.ToString() : v.ColorId?.ToString()) + "|" + (v.Size?.Label ?? ""))
        .ToDictionary(g => g.Key, g =>
        {
            var basePriceForVariant = g.First().Price ?? Model.Price;
            var finalPrice = activeEvent != null
                ? basePriceForVariant * (1 - activeEvent.DiscountPercent / 100m)
                : basePriceForVariant;
            // The "You save X (Y%)" line's percent never changes (same event for every variant),
            // but the AED amount does when the variant's own base price differs from Model.Price
            // — server-rendered here (not reconstructed client-side) so the localized word order
            // stays correct in both EN and AR.
            string? savingsText = activeEvent != null
                ? Localizer["You save {0} ({1}%)", (basePriceForVariant - finalPrice).ToDisplayCurrency(), activeEvent.DiscountPercent.ToString("0.##")].Value
                : null;
            return new
            {
                price = finalPrice.ToDisplayCurrencyValue(),
                priceFormatted = finalPrice.ToDisplayCurrency(),
                savingsText
            };
        });
    var variantPriceDataJson = JsonSerializer.Serialize(variantPriceByKey);
    var variantSkuDataJson = JsonSerializer.Serialize(variantSkuByKey);

    var initialColorKey = hasProductColors
        ? defaultProductColor?.Id.ToString()
        : (colorOptions.Count > 0 ? colorOptions[0].Color.Id.ToString() : null);
    var initialSizeLabel = initialSizeOptions.Count > 0 ? initialSizeOptions[0].Label : null;
    var initialVariantSku = variantSkuByKey.GetValueOrDefault($"{initialColorKey}|{initialSizeLabel}", Model.Sku);

    // Description-tab feature bullets — rows in the Attributes sheet with Attribute Code
    // "FEATURE" (kept out of the Specifications table below; those are real spec facts,
    // these are marketing bullets, so they're excluded from one another's sections).
    var featureBullets = Model.AttributeValues
        .Where(a => a.AttributeDefinition?.Code == "FEATURE")
        .OrderBy(a => a.DisplayOrder)
        .Select(a => isArabicUi && !string.IsNullOrWhiteSpace(a.ValueAr) ? a.ValueAr! : a.ValueEn)
        .ToList();
    var specAttributeValues = Model.AttributeValues.Where(a => a.AttributeDefinition?.Code != "FEATURE").ToList();

    // Description-tab lifestyle photo — a Media row with Role "Lifestyle", scoped to a color
    // the same way gallery photos are. Each color falls back to the default color's lifestyle
    // photo when it doesn't have its own; the whole slot is hidden if nothing exists at all.
    Dictionary<int, string?> lifestyleByColorId = new();
    string? initialLifestyleUrl = null;
    if (hasProductColors)
    {
        var defaultLifestyleUrl = Model.Media.FirstOrDefault(m => m.ProductColorId == defaultProductColor!.Id && m.MediaRole == "Lifestyle")?.MediaUrl;
        foreach (var pc in Model.ProductColors)
        {
            var ownUrl = Model.Media.FirstOrDefault(m => m.ProductColorId == pc.Id && m.MediaRole == "Lifestyle")?.MediaUrl;
            lifestyleByColorId[pc.Id] = ownUrl ?? defaultLifestyleUrl;
        }
        initialLifestyleUrl = lifestyleByColorId.GetValueOrDefault(defaultProductColor!.Id);
    }
    else
    {
        initialLifestyleUrl = Model.Media.FirstOrDefault(m => m.ProductColorId == null && m.MediaRole == "Lifestyle")?.MediaUrl;
    }
    var hasAnyLifestylePhoto = lifestyleByColorId.Values.Any(v => !string.IsNullOrEmpty(v)) || !string.IsNullOrEmpty(initialLifestyleUrl);
    var lifestyleDataJson = JsonSerializer.Serialize(lifestyleByColorId);
}

<div class="container mt-4 mb-5">
    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-success">@TempData["CartMessage"]</div>
    }
    @if (TempData["ReviewMessage"] != null)
    {
        <div class="alert alert-success">@TempData["ReviewMessage"]</div>
    }
    <nav class="mb-3">
        <a asp-controller="Products" asp-action="Index">@Localizer["All Products"]</a> /
        <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category?.LocalizedName()</a>
        @if (Model.Subcategory != null)
        {
            <text> / <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@Model.CategoryId" asp-route-subcategoryId="@Model.SubcategoryId">@Model.Subcategory.LocalizedName()</a></text>
        }
        / <span>@Model.LocalizedName()</span>
    </nav>

    <div class="row g-5 pdp-top-row">
        <div class="col-12 col-lg-5 pdp-gallery-col">
            @if (hasProductColors && Model.ProductColors.Count > 1)
            {
                var galleryPanelViewData = new ViewDataDictionary(ViewData);
                galleryPanelViewData["GalleryByColorId"] = galleryByColorId;
                galleryPanelViewData["ColorThumbItems"] = colorThumbItems;
                galleryPanelViewData["SharedGalleryItems"] = sharedGalleryItems;
                <partial name="_PdpColorGallery" model="Model" view-data="galleryPanelViewData" />
                <script type="application/json" id="colorGalleryData">@Html.Raw(galleryDataJson)</script>
                <script type="application/json" id="colorThumbData">@Html.Raw(colorThumbItemsJson)</script>
            }
            else if (hasProductColors)
            {
                var initialActiveIndex = initialGallery.FindIndex(item => item.GetValueOrDefault("active") == "1");
                if (initialActiveIndex < 0) { initialActiveIndex = 0; }
                var firstItem = initialGallery[initialActiveIndex];
                var firstIsVideo = firstItem["type"] == "Video";
                <div class="product-gallery-layout">
                    @if (initialGallery.Count > 1 || Model.ProductColors.Count > 1)
                    {
                        <div class="product-thumbs-wrap" id="productThumbsWrap">
                            <button type="button" class="product-thumbs-arrow product-thumbs-arrow-prev" id="thumbsArrowPrev" aria-label="@Localizer["Scroll thumbnails up"]">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                            <div class="product-thumbs" id="productThumbs">
                                @for (int i = 0; i < initialGallery.Count; i++)
                                {
                                    var item = initialGallery[i];
                                    var isVideo = item["type"] == "Video";
                                    <span class="product-thumb-item">
                                        <img src="@(item["thumb"] ?? ImagePlaceholder.DataUri)"
                                             class="product-thumb @(i == initialActiveIndex ? "active" : "")"
                                             data-full="@item["url"]" data-type="@item["type"]" data-color-id="@item.GetValueOrDefault("colorId")"
                                             alt="@(item["alt"] ?? Model.LocalizedName())" />
                                        @if (isVideo)
                                        {
                                            <i class="bi bi-play-circle-fill product-thumb-play"></i>
                                        }
                                    </span>
                                }
                            </div>
                            <button type="button" class="product-thumbs-arrow product-thumbs-arrow-next" id="thumbsArrowNext" aria-label="@Localizer["Scroll thumbnails down"]">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                    }
                    <div class="product-zoom-container" id="zoomContainer">
                        <img src="@(firstIsVideo ? (firstItem["thumb"] ?? ImagePlaceholder.DataUri) : firstItem["url"])" alt="@Model.LocalizedName()" class="product-zoom-image" id="mainProductImage" style="@(firstIsVideo ? "display:none;" : "")" />
                        <video id="mainProductVideo" controls class="product-zoom-video" style="@(firstIsVideo ? "" : "display:none;")">
                            @if (firstIsVideo)
                            {
                                <source src="@firstItem["url"]" />
                            }
                        </video>
                        <span class="zoom-hint"><i class="bi bi-zoom-in"></i> @Localizer["Hover to zoom · Click to enlarge"]</span>
                    </div>
                </div>
                <script type="application/json" id="colorGalleryData">@Html.Raw(galleryDataJson)</script>
            }
            else
            {
                <div class="product-gallery-layout">
                    @if (gallery.Count > 1)
                    {
                        <div class="product-thumbs-wrap" id="productThumbsWrap">
                            <button type="button" class="product-thumbs-arrow product-thumbs-arrow-prev" id="thumbsArrowPrev" aria-label="@Localizer["Scroll thumbnails up"]">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                            <div class="product-thumbs" id="productThumbs">
                                @for (int i = 0; i < gallery.Count; i++)
                                {
                                    <img src="@gallery[i]" class="product-thumb @(i == 0 ? "active" : "")" data-full="@gallery[i]" data-type="Image" alt="@Model.LocalizedName() view @(i + 1)" />
                                }
                            </div>
                            <button type="button" class="product-thumbs-arrow product-thumbs-arrow-next" id="thumbsArrowNext" aria-label="@Localizer["Scroll thumbnails down"]">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                    }
                    <div class="product-zoom-container" id="zoomContainer">
                        <img src="@gallery[0]" alt="@Model.LocalizedName()" class="product-zoom-image" id="mainProductImage" />
                        <span class="zoom-hint"><i class="bi bi-zoom-in"></i> @Localizer["Hover to zoom · Click to enlarge"]</span>
                    </div>
                </div>
            }
            @if (Model.Features.Count > 0)
            {
                <div class="pdp-icon-feature-row">
                    @foreach (var feature in Model.Features)
                    {
                        <div class="pdp-icon-feature-item">
                            <span class="pdp-icon-feature-circle"><i class="bi @(string.IsNullOrWhiteSpace(feature.IconClass) ? "bi-check-circle" : feature.IconClass)"></i></span>
                            <span class="pdp-icon-feature-label">@(isArabicUi && !string.IsNullOrWhiteSpace(feature.NameAr) ? feature.NameAr : feature.Name)</span>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="col-12 col-lg-7 pdp-content-col">
            @if (Model.Brand != null)
            {
                <span class="pdp-brand-badge">@Model.Brand.LocalizedName()</span>
            }
            <span class="category-tag">@Model.Category?.LocalizedName()</span>
            <h1>@Model.LocalizedName()</h1>
            <p class="pdp-meta-line mt-1 mb-1">
                @Localizer["SKU"]: <span id="pdpSkuValue" data-base-sku="@Model.Sku">@initialVariantSku</span>
                @if (Model.Brand != null)
                {
                    <text><span class="pdp-meta-sep">|</span> @Localizer["Brand"]: @Model.Brand.LocalizedName()</text>
                }
            </p>
            <div class="pdp-rating-row">
                <partial name="_StarRating" model="Model" />
                <span class="pdp-review-count">(@Localizer["{0} reviews", Model.ReviewCount])</span>
                <span class="pdp-rating-sep">|</span>
                <a class="pdp-ask-question" asp-controller="Home" asp-action="Contact">@Localizer["Ask a question"]</a>
            </div>
            @if (Model.Merchant != null)
            {
                <p class="text-muted small mb-2"><i class="bi bi-shop"></i> @Localizer["Sold by"] <strong>@Model.Merchant.BusinessName</strong></p>
            }

            @if (Model.StockQuantity > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" id="pdpAddToCartForm">
                    <input type="hidden" name="productId" value="@Model.Id" />

                    @if (salePrice.HasValue)
                    {
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="sale-ribbon"><i class="bi bi-stars"></i> @activeEvent!.Name &mdash; @activeEvent.DiscountPercent.ToString("0.##")% @Localizer["OFF"]</span>
                        </div>
                    }
                    <h2 class="pdp-price mb-1"><span id="pdpPriceValue">@((salePrice ?? Model.Price).ToDisplayCurrency())</span></h2>
                    @if (Model.VatRate.HasValue)
                    {
                        <p class="pdp-vat-note mb-1"><i class="bi bi-info-circle" title="@Localizer["Includes {0}% VAT", (Model.VatRate.Value * 100).ToString("0.##")]"></i> @Localizer["VAT Included"]</p>
                    }
                    @if (salePrice.HasValue)
                    {
                        var saveAmount = Model.Price - salePrice.Value;
                        <p class="pdp-savings mb-1" id="pdpSavingsLine" data-base-savings-text="@Localizer["You save {0} ({1}%)", saveAmount.ToDisplayCurrency(), activeEvent!.DiscountPercent.ToString("0.##")]">@Localizer["You save {0} ({1}%)", saveAmount.ToDisplayCurrency(), activeEvent!.DiscountPercent.ToString("0.##")]</p>
                    }
                    <p class="pdp-stock-line mb-3">
                        <span class="pdp-stock-dot"></span> @Localizer["In Stock"]
                        <span class="pdp-meta-sep">|</span>
                        @Localizer["Total"]: <strong id="cartTotalPrice">@currencySymbol@effectiveUnitPrice.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</strong>
                    </p>

                    @if (hasProductColors)
                    {
                        <div class="mb-3">
                            <label class="option-label">@Localizer["Color"]</label>
                            <div class="color-options">
                                @for (int i = 0; i < Model.ProductColors.Count; i++)
                                {
                                    var pc = Model.ProductColors.ElementAt(i);
                                    var isSelected = pc.Id == defaultProductColor!.Id;
                                    var fallbackImage = galleryByColorId.GetValueOrDefault(pc.Id)?.FirstOrDefault()?.GetValueOrDefault("url");
                                    // Solid swatch color always — a photo thumbnail here (even
                                    // the color's own swatch photo) reads as visually identical
                                    // across colors at this size and defeats the point of a
                                    // color picker.
                                    var swatchStyle = $"background-color: {pc.Color?.HexCode};";
                                    <label class="color-swatch" style="@swatchStyle" title="@pc.Color?.Name">
                                        <input type="radio" name="color" value="@pc.Color?.Name" data-color-id="@pc.Id" data-image="@(ImagePlaceholder.IsRealImageUrl(fallbackImage) ? fallbackImage : Model.ImageUrl)" data-label="@pc.Color?.Name" required="@(i == 0 ? "required" : null)" checked="@(isSelected ? "checked" : null)" />
                                    </label>
                                }
                            </div>
                            <span class="option-value" id="selectedColorLabel">@defaultProductColor!.Color?.Name</span>
                        </div>
                    }
                    else if (!hasProductColors && colorOptions.Count > 0)
                    {
                        var defaultLegacyColorIndex = !string.IsNullOrEmpty(requestedColorName)
                            ? Math.Max(0, colorOptions.FindIndex(o => string.Equals(o.Color.Name, requestedColorName, StringComparison.OrdinalIgnoreCase)))
                            : 0;
                        <div class="mb-3">
                            <label class="option-label">@Localizer["Color"]</label>
                            <div class="color-options">
                                @for (int i = 0; i < colorOptions.Count; i++)
                                {
                                    var opt = colorOptions[i];
                                    var swatchStyle = $"background-color: {opt.Color.HexCode};";
                                    <label class="color-swatch" style="@swatchStyle" title="@opt.Color.Name">
                                        <input type="radio" name="color" value="@opt.Color.Name" data-color-id="@opt.Color.Id" data-image="@(ImagePlaceholder.IsRealImageUrl(opt.ImageUrl) ? opt.ImageUrl : Model.ImageUrl)" data-label="@opt.Color.Name" required="@(i == 0 ? "required" : null)" checked="@(i == defaultLegacyColorIndex ? "checked" : null)" />
                                    </label>
                                }
                            </div>
                            <span class="option-value" id="selectedColorLabel">@colorOptions[defaultLegacyColorIndex].Color.Name</span>
                        </div>
                    }

                    @if (isWaistLengthSplitProduct)
                    {
                        var initialCombos = waistLengthComboByColorId[defaultProductColor!.Id];
                        var initialHiddenValue = initialCombos.TryGetValue($"{initialWaist}|{initialLength}", out var initialCombo)
                            ? initialCombo.Label
                            : (sizeOptions.FirstOrDefault()?.Label ?? "");
                        <div class="mb-3">
                            <label class="option-label">@Localizer["Waist"]: <span id="selectedWaistLabel">@initialWaist</span></label>
                            <div class="size-options" id="waistOptionsContainer">
                                @foreach (var w in waistsByColorId[defaultProductColor.Id])
                                {
                                    // Disabled only when NO length at all works for this waist — a waist with
                                    // even one in-stock length stays selectable regardless of which length
                                    // happens to be selected right now (see product-gallery.js for the matching
                                    // client-side rule and the auto-switch-length-on-pick behavior).
                                    var isDisabled = !lengthsByColorId[defaultProductColor.Id].Any(l => StockFor(initialCombos, $"{w}|{l}") > 0);
                                    <label class="size-pill @(isDisabled ? "unavailable" : "")">
                                        <input type="radio" name="waistOption" value="@w" disabled="@(isDisabled ? "disabled" : null)" required="@(w == initialWaist ? "required" : null)" checked="@(w == initialWaist ? "checked" : null)" />
                                        <span>@w</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="option-label">@Localizer["Length"]: <span id="selectedLengthLabel">@initialLength</span></label>
                            <div class="size-options" id="lengthOptionsContainer">
                                @foreach (var l in lengthsByColorId[defaultProductColor.Id])
                                {
                                    // Same rule mirrored for length: disabled only when NO waist works for it.
                                    var isDisabled = !waistsByColorId[defaultProductColor.Id].Any(w => StockFor(initialCombos, $"{w}|{l}") > 0);
                                    <label class="size-pill @(isDisabled ? "unavailable" : "")">
                                        <input type="radio" name="lengthOption" value="@l" disabled="@(isDisabled ? "disabled" : null)" required="@(l == initialLength ? "required" : null)" checked="@(l == initialLength ? "checked" : null)" />
                                        <span>@l</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <input type="hidden" name="size" id="pdpSizeHiddenInput" value="@initialHiddenValue" />
                        <script type="application/json" id="waistLengthConfig">@Html.Raw(JsonSerializer.Serialize(new { enabled = true }))</script>
                        <script type="application/json" id="waistsByColorData">@Html.Raw(JsonSerializer.Serialize(waistsByColorId))</script>
                        <script type="application/json" id="lengthsByColorData">@Html.Raw(JsonSerializer.Serialize(lengthsByColorId))</script>
                        <script type="application/json" id="waistLengthComboData">@Html.Raw(waistLengthComboDataJson)</script>
                    }
                    else if (isSplitSizeProduct && initialSizeOptions.Count > 0)
                    {
                        var initialDecomposed = initialSizeOptions.Select(s => DecomposeSize(s.Label)).ToList();
                        var initialUnits = initialDecomposed.Select(d => d.Unit).Distinct().ToList();
                        var initialLengths = initialDecomposed.Select(d => d.Length).Distinct().OrderBy(LengthSortRank).ToList();
                        <div class="mb-3">
                            <label class="option-label">@Localizer["Size"]</label>
                            <div class="size-options" id="sizeUnitOptionsContainer">
                                @for (int i = 0; i < initialUnits.Count; i++)
                                {
                                    <label class="size-pill">
                                        <input type="radio" name="sizeUnit" value="@initialUnits[i]" required="@(i == 0 ? "required" : null)" checked="@(i == 0 ? "checked" : null)" />
                                        <span>@initialUnits[i]</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="option-label">@Localizer["Length"]</label>
                            <div class="size-options" id="sizeLengthOptionsContainer">
                                @for (int i = 0; i < initialLengths.Count; i++)
                                {
                                    <label class="size-pill">
                                        <input type="radio" name="sizeLength" value="@initialLengths[i]" required="@(i == 0 ? "required" : null)" checked="@(i == 0 ? "checked" : null)" />
                                        <span>@initialLengths[i]</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <input type="hidden" name="size" id="pdpSizeHiddenInput" value="@initialSizeOptions[0].Label" />
                        <script type="application/json" id="splitSizeConfig">@Html.Raw(JsonSerializer.Serialize(new { enabled = true }))</script>
                        @if (hasProductColors)
                        {
                            <script type="application/json" id="sizesByColorData">@Html.Raw(sizeDataJson)</script>
                        }
                    }
                    else if (initialSizeOptions.Count > 0 || hasProductColors)
                    {
                        <div class="mb-3">
                            <label class="option-label">@Localizer["Size"]</label>
                            <div class="size-options" id="sizeOptionsContainer">
                                @for (int i = 0; i < initialSizeOptions.Count; i++)
                                {
                                    var size = initialSizeOptions[i];
                                    <label class="size-pill">
                                        <input type="radio" name="size" value="@size.Label" required="@(i == 0 ? "required" : null)" checked="@(i == 0 ? "checked" : null)" />
                                        <span>@size.Label</span>
                                    </label>
                                }
                            </div>
                        </div>
                        @if (hasProductColors)
                        {
                            <script type="application/json" id="sizesByColorData">@Html.Raw(sizeDataJson)</script>
                        }
                    }

                    @if (Model.Variants.Count > 0)
                    {
                        <script type="application/json" id="variantSkuData">@Html.Raw(variantSkuDataJson)</script>
                        <script type="application/json" id="variantPriceData">@Html.Raw(variantPriceDataJson)</script>
                    }

                    <div class="pdp-qty-cart-row mb-2">
                        <div class="pdp-qty-stepper">
                            <button type="button" class="pdp-qty-btn" id="cartQtyDecrement" aria-label="@Localizer["Decrease quantity"]">&minus;</button>
                            <input type="number" name="quantity" id="cartQuantityInput" value="1" min="1" max="@Model.StockQuantity" class="pdp-qty-input"
                                   data-unit-price="@effectiveUnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-currency-symbol="@currencySymbol"
                                   data-base-price="@effectiveUnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-base-price-formatted="@((salePrice ?? Model.Price).ToDisplayCurrency())" />
                            <button type="button" class="pdp-qty-btn" id="cartQtyIncrement" aria-label="@Localizer["Increase quantity"]">&plus;</button>
                        </div>
                        <div class="pdp-btn-row">
                            <button type="submit" class="pdp-btn-cart" id="pdpAddToCartBtn"><i class="bi bi-cart3"></i> @Localizer["Add to Cart"]</button>
                            <button type="submit" name="redirectToCheckout" value="true" class="pdp-btn-buynow">@Localizer["Buy Now"]</button>
                        </div>
                    </div>
                    <div class="checkout-step-error" id="pdpCartError" data-generic-error="@Localizer["Something went wrong. Please try again."]"></div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button type="button" class="pdp-btn-wishlist js-favorite-toggle @(detailIsFavorite ? "active" : "")" data-product-id="@Model.Id"
                                aria-pressed="@(detailIsFavorite ? "true" : "false")">
                            <i class="bi @(detailIsFavorite ? "bi-heart-fill" : "bi-heart")"></i> @Localizer["Add to Wishlist"]
                        </button>
                    }
                    else
                    {
                        <a class="pdp-btn-wishlist" asp-area="Identity" asp-page="/Account/Login">
                            <i class="bi bi-heart"></i> @Localizer["Add to Wishlist"]
                        </a>
                    }

                    <div class="pdp-secondary-links">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button type="button" class="pdp-wishlist-link js-compare-toggle @(detailIsInCompare ? "active" : "")" data-product-id="@Model.Id"
                                    aria-pressed="@(detailIsInCompare ? "true" : "false")">
                                <i class="bi bi-arrow-left-right"></i> @(detailIsInCompare ? Localizer["In Comparison"] : Localizer["Add to Compare"])
                            </button>
                        }
                        else
                        {
                            <a class="pdp-wishlist-link" asp-area="Identity" asp-page="/Account/Login">
                                <i class="bi bi-arrow-left-right"></i> @Localizer["Add to Compare"]
                            </a>
                        }
                        <a class="pdp-wishlist-link" asp-controller="QuoteRequests" asp-action="Create" asp-route-productDetails="@($"{Model.Name} (SKU: {Model.Sku})")">
                            <i class="bi bi-file-earmark-text"></i> @Localizer["Request Wholesale Quote"]
                        </a>
                    </div>

                    <div class="pdp-trust-mini-row mt-3">
                        <div class="pdp-trust-mini-item">
                            <i class="bi bi-truck"></i>
                            <div><strong>@Localizer["Free Shipping"]</strong><span>@Localizer["Orders over AED 365"]</span></div>
                        </div>
                        <div class="pdp-trust-mini-item">
                            <i class="bi bi-arrow-repeat"></i>
                            <div><strong>@Localizer["Easy Returns"]</strong><span>@Localizer["Within 30 days"]</span></div>
                        </div>
                        <div class="pdp-trust-mini-item">
                            <i class="bi bi-shield-check"></i>
                            <div><strong>@Localizer["Secure Payment"]</strong><span>@Localizer["100% secure checkout"]</span></div>
                        </div>
                    </div>
                </form>
            }
            else
            {
                @if (salePrice.HasValue)
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="sale-ribbon"><i class="bi bi-stars"></i> @activeEvent!.Name &mdash; @activeEvent.DiscountPercent.ToString("0.##")% @Localizer["OFF"]</span>
                    </div>
                }
                <h2 class="pdp-price mb-1">@((salePrice ?? Model.Price).ToDisplayCurrency())</h2>
                @if (Model.VatRate.HasValue)
                {
                    <p class="pdp-vat-note mb-1"><i class="bi bi-info-circle" title="@Localizer["Includes {0}% VAT", (Model.VatRate.Value * 100).ToString("0.##")]"></i> @Localizer["VAT Included"]</p>
                }
                <p class="text-danger mb-3"><i class="bi bi-x-circle"></i> @Localizer["Out of Stock"]</p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button type="button" class="favorite-toggle favorite-toggle-detail js-favorite-toggle @(detailIsFavorite ? "active" : "")" data-product-id="@Model.Id"
                            aria-label="@Localizer["Add to Favorites"]" aria-pressed="@(detailIsFavorite ? "true" : "false")">
                        <i class="bi @(detailIsFavorite ? "bi-heart-fill" : "bi-heart")"></i>
                    </button>
                }
                else
                {
                    <a class="favorite-toggle favorite-toggle-detail" asp-area="Identity" asp-page="/Account/Login" aria-label="@Localizer["Add to Favorites"]">
                        <i class="bi bi-heart"></i>
                    </a>
                }
            }
        </div>
    </div>

    <div class="pdp-trust-strip mt-3">
        <div class="pdp-trust-strip-item">
            <i class="bi bi-patch-check"></i>
            <div><span>@Localizer["100% Authentic"]</span><strong>@Localizer["Original Products"]</strong></div>
        </div>
        <div class="pdp-trust-strip-item">
            <i class="bi bi-shield-check"></i>
            <div><span>@Localizer["Secure Payments"]</span><strong>@Localizer["100% secure checkout"]</strong></div>
        </div>
        <div class="pdp-trust-strip-item">
            <i class="bi bi-arrow-repeat"></i>
            <div><span>@Localizer["Easy Returns"]</span><strong>@Localizer["Within 30 days"]</strong></div>
        </div>
        <div class="pdp-trust-strip-item">
            <i class="bi bi-headset"></i>
            <div><span>@Localizer["Customer Support"]</span><strong>@Localizer["24/7 Dedicated Help"]</strong></div>
        </div>
    </div>

    <div class="pdp-accordion mt-4" id="pdpAccordion">
        @if (featureBullets.Count > 0)
        {
            <div class="pdp-accordion-item">
                <h3 class="pdp-accordion-header">
                    <button class="pdp-accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#pdpAccFeatures" aria-expanded="false" aria-controls="pdpAccFeatures">
                        @Localizer["Features"]
                        <span class="pdp-accordion-icon"><i class="bi bi-plus-lg pdp-accordion-icon-plus"></i><i class="bi bi-x-lg pdp-accordion-icon-close"></i></span>
                    </button>
                </h3>
                <div id="pdpAccFeatures" class="collapse" data-bs-parent="#pdpAccordion">
                    <div class="pdp-accordion-body">
                        <ul class="pdp-checklist">
                            @foreach (var bullet in featureBullets)
                            {
                                <li><i class="bi bi-check-circle-fill"></i> @bullet</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
        @if (specAttributeValues.Count > 0)
        {
            <div class="pdp-accordion-item">
                <h3 class="pdp-accordion-header">
                    <button class="pdp-accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#pdpAccSpecifications" aria-expanded="false" aria-controls="pdpAccSpecifications">
                        @Localizer["Specifications"]
                        <span class="pdp-accordion-icon"><i class="bi bi-plus-lg pdp-accordion-icon-plus"></i><i class="bi bi-x-lg pdp-accordion-icon-close"></i></span>
                    </button>
                </h3>
                <div id="pdpAccSpecifications" class="collapse" data-bs-parent="#pdpAccordion">
                    <div class="pdp-accordion-body">
                        <table class="pdp-spec-table">
                            <tbody>
                                @foreach (var attr in specAttributeValues)
                                {
                                    <tr>
                                        <th>@(isArabicUi ? (attr.AttributeDefinition?.NameAr ?? attr.AttributeDefinition?.NameEn) : attr.AttributeDefinition?.NameEn)</th>
                                        <td>@(isArabicUi && !string.IsNullOrWhiteSpace(attr.ValueAr) ? attr.ValueAr : attr.ValueEn)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.LocalizedOverview()))
        {
            <div class="pdp-accordion-item">
                <h3 class="pdp-accordion-header">
                    <button class="pdp-accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#pdpAccOverview" aria-expanded="false" aria-controls="pdpAccOverview">
                        @Localizer["Overview"]
                        <span class="pdp-accordion-icon"><i class="bi bi-plus-lg pdp-accordion-icon-plus"></i><i class="bi bi-x-lg pdp-accordion-icon-close"></i></span>
                    </button>
                </h3>
                <div id="pdpAccOverview" class="collapse" data-bs-parent="#pdpAccordion">
                    <div class="pdp-accordion-body">
                        @foreach (var paragraph in Model.LocalizedOverview()!.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <p>@paragraph</p>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="pdp-accordion-item">
            <h3 class="pdp-accordion-header">
                <button class="pdp-accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#pdpAccDescription" aria-expanded="false" aria-controls="pdpAccDescription">
                    @Localizer["Description"]
                    <span class="pdp-accordion-icon"><i class="bi bi-plus-lg pdp-accordion-icon-plus"></i><i class="bi bi-x-lg pdp-accordion-icon-close"></i></span>
                </button>
            </h3>
            <div id="pdpAccDescription" class="collapse" data-bs-parent="#pdpAccordion">
                <div class="pdp-accordion-body">
                    <div class="pdp-description-layout">
                        <div class="pdp-description-text">
                            @if (!string.IsNullOrWhiteSpace(Model.LocalizedShortDescription()))
                            {
                                <p>@Model.LocalizedShortDescription()</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.LocalizedDescription()))
                            {
                                <p>@Model.LocalizedDescription()</p>
                            }
                        </div>
                        @if (hasAnyLifestylePhoto)
                        {
                            <div class="pdp-description-photo" id="pdpLifestylePhoto" style="@(string.IsNullOrEmpty(initialLifestyleUrl) ? "display:none;" : "")">
                                <img id="pdpLifestyleImage" src="@initialLifestyleUrl" alt="@Model.LocalizedName()" />
                            </div>
                            <script type="application/json" id="lifestyleByColorData">@Html.Raw(lifestyleDataJson)</script>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="pdp-accordion-item">
            <h3 class="pdp-accordion-header">
                <button class="pdp-accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#pdpAccReviews" aria-expanded="false" aria-controls="pdpAccReviews">
                    @Localizer["Reviews"] (@Model.ReviewCount)
                    <span class="pdp-accordion-icon"><i class="bi bi-plus-lg pdp-accordion-icon-plus"></i><i class="bi bi-x-lg pdp-accordion-icon-close"></i></span>
                </button>
            </h3>
            <div id="pdpAccReviews" class="collapse" data-bs-parent="#pdpAccordion">
                <div class="pdp-accordion-body">
                    <div class="pdp-reviews-summary">
                        <partial name="_StarRating" model="Model" />
                        <span class="pdp-reviews-summary-count">@Model.Rating.ToString("0.0") &middot; @Localizer["{0} reviews", Model.ReviewCount]</span>
                    </div>

                    <div class="pdp-review-form-section">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <h3 class="pdp-review-form-heading">@(myReview != null ? Localizer["Update Your Review"] : Localizer["Write a Review"])</h3>
                            <form asp-controller="Reviews" asp-action="Submit" method="post" class="pdp-review-form">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <input type="hidden" name="slug" value="@Model.Slug" />
                                <div class="pdp-star-input" id="reviewStarInput">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <button type="button" class="pdp-star-input-btn @(myReview != null && myReview.Rating >= i ? "active" : "")" data-value="@i" aria-label="@Localizer["{0} stars", i]">
                                            <i class="bi @(myReview != null && myReview.Rating >= i ? "bi-star-fill" : "bi-star")"></i>
                                        </button>
                                    }
                                    <input type="hidden" name="rating" id="reviewRatingInput" value="@(myReview?.Rating ?? 0)" />
                                </div>
                                <textarea name="comment" class="pdp-review-textarea" minlength="10" maxlength="1000" required
                                          placeholder="@Localizer["Share your thoughts about this product (10–1000 characters)..."]">@(myReview?.Comment)</textarea>
                                <button type="submit" class="pdp-btn-buynow pdp-review-submit">@(myReview != null ? Localizer["Update Review"] : Localizer["Submit Review"])</button>
                            </form>
                        }
                        else
                        {
                            <p class="pdp-review-login-prompt">
                                @Localizer["Please log in to leave a review."]
                                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Details", "Products", new { slug = Model.Slug })">@Localizer["Log in"]</a>
                            </p>
                        }
                    </div>

                    @if (productReviews.Count > 0)
                    {
                        <div class="pdp-review-list">
                            @foreach (var review in productReviews)
                            {
                                <div class="pdp-review-item">
                                    <div class="pdp-review-item-header">
                                        <partial name="_StarRatingValue" model="(decimal)review.Rating" />
                                        <span class="pdp-review-author">@review.ReviewerName</span>
                                        <span class="pdp-review-date">@review.CreatedAt.ToString("MMM d, yyyy")</span>
                                    </div>
                                    <p class="pdp-review-comment">@review.Comment</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="pdp-accordion-item">
            <h3 class="pdp-accordion-header">
                <button class="pdp-accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#pdpAccShipping" aria-expanded="false" aria-controls="pdpAccShipping">
                    @Localizer["Shipping & Returns"]
                    <span class="pdp-accordion-icon"><i class="bi bi-plus-lg pdp-accordion-icon-plus"></i><i class="bi bi-x-lg pdp-accordion-icon-close"></i></span>
                </button>
            </h3>
            <div id="pdpAccShipping" class="collapse" data-bs-parent="#pdpAccordion">
                <div class="pdp-accordion-body">
                    <p>@Localizer["We deliver across all seven Emirates, with free shipping on orders over AED 365."]</p>
                    <p>@Localizer["Most items ship out within 1-2 business days of your order."]</p>
                    <p>@Localizer["Not the right fit? Returns are accepted within 30 days of delivery — see our"] <a asp-controller="Home" asp-action="ReturnPolicy">@Localizer["Return & Refund Policy"]</a>.</p>
                </div>
            </div>
        </div>
    </div>

    @if (related.Count > 0)
    {
        <div class="d-flex justify-content-between align-items-center mt-5">
            <div class="section-title mb-0">
                <h2>@Localizer["You May Also Like"]</h2>
            </div>
            <a class="pdp-view-all" asp-controller="Products" asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Localizer["View All"] <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="product-carousel">
            <button type="button" class="product-carousel-arrow product-carousel-prev" aria-label="@Localizer["Previous"]"><i class="bi bi-chevron-left"></i></button>
            <div class="product-carousel-track">
                @foreach (var product in related)
                {
                    <div class="product-carousel-item">
                        <partial name="_ProductCard" model="product" />
                    </div>
                }
            </div>
            <button type="button" class="product-carousel-arrow product-carousel-next" aria-label="@Localizer["Next"]"><i class="bi bi-chevron-right"></i></button>
        </div>
    }
</div>

<div class="zoom-lightbox" id="zoomLightbox">
    <button type="button" class="zoom-lightbox-close" id="zoomLightboxClose" aria-label="@Localizer["Close"]">&times;</button>
    <button type="button" class="zoom-lightbox-arrow zoom-lightbox-prev" id="zoomLightboxPrev" aria-label="@Localizer["Previous"]"><i class="bi bi-chevron-left"></i></button>
    <img src="" alt="" id="zoomLightboxImage" />
    <button type="button" class="zoom-lightbox-arrow zoom-lightbox-next" id="zoomLightboxNext" aria-label="@Localizer["Next"]"><i class="bi bi-chevron-right"></i></button>
    <span class="zoom-lightbox-counter" id="zoomLightboxCounter"></span>
</div>

@section Scripts {
    <script src="~/js/product-gallery.js" asp-append-version="true"></script>
    @if (TempData["ReviewMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var reviewsPanel = document.getElementById("pdpAccReviews");
                if (reviewsPanel && window.bootstrap) {
                    new bootstrap.Collapse(reviewsPanel, { show: true });
                    reviewsPanel.addEventListener("shown.bs.collapse", function () {
                        reviewsPanel.scrollIntoView({ behavior: "smooth", block: "start" });
                    }, { once: true });
                }
            });
        </script>
    }
    <script>
        (function () {
            var qtyInput = document.getElementById("cartQuantityInput");
            var totalEl = document.getElementById("cartTotalPrice");
            if (!qtyInput || !totalEl) return;

            var symbol = qtyInput.getAttribute("data-currency-symbol") || "";

            // Re-read data-unit-price on every call rather than capturing it once — product-
            // gallery.js updates that attribute (and dispatches "change") whenever the selected
            // color/size resolves to a variant with its own price, so the total stays correct
            // across variant switches, not just quantity changes.
            function updateTotal() {
                var qty = parseInt(qtyInput.value, 10);
                if (!qty || qty < 1) qty = 1;
                var unitPrice = parseFloat(qtyInput.getAttribute("data-unit-price"));
                var total = unitPrice * qty;
                totalEl.textContent = symbol + total.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            qtyInput.addEventListener("input", updateTotal);
            qtyInput.addEventListener("change", updateTotal);

            var decrementBtn = document.getElementById("cartQtyDecrement");
            var incrementBtn = document.getElementById("cartQtyIncrement");
            var min = parseInt(qtyInput.getAttribute("min"), 10) || 1;
            var max = parseInt(qtyInput.getAttribute("max"), 10) || Infinity;

            function step(delta) {
                var qty = parseInt(qtyInput.value, 10);
                if (!qty) qty = min;
                qty = Math.min(max, Math.max(min, qty + delta));
                qtyInput.value = qty;
                updateTotal();
            }

            if (decrementBtn) decrementBtn.addEventListener("click", function () { step(-1); });
            if (incrementBtn) incrementBtn.addEventListener("click", function () { step(1); });
        })();
    </script>
}
