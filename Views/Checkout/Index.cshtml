@using WorldLinkMaster.Web.Models.ViewModels
@using Microsoft.AspNetCore.Identity
@using WorldLinkMaster.Web.Models
@inject UserManager<ApplicationUser> UserManager
@model CheckoutViewModel
@{
    ViewData["Title"] = Localizer["Checkout"];
    var checkoutUserEmail = User.Identity != null ? (await UserManager.GetUserAsync(User))?.Email : null;
}

@Html.AntiForgeryToken()

<div class="page-banner">
    <div class="container"><h1>@Localizer["Checkout"]</h1></div>
</div>

<div class="container mb-5" id="checkout-wizard-root" data-user-email="@checkoutUserEmail">
    @if (TempData["CheckoutMessage"] != null)
    {
        <div class="alert alert-info">@TempData["CheckoutMessage"]</div>
    }

    <ol class="checkout-stepper" id="checkoutStepper">
        <li class="checkout-step active" data-step="1"><span class="checkout-step-num">1</span> @Localizer["Shipping"]</li>
        <li class="checkout-step" data-step="2"><span class="checkout-step-num">2</span> @Localizer["Payment"]</li>
        <li class="checkout-step" data-step="3"><span class="checkout-step-num">3</span> @Localizer["Review"]</li>
        <li class="checkout-step" data-step="4"><span class="checkout-step-num">4</span> @Localizer["Confirmation"]</li>
    </ol>

    <div class="row">
        <div class="col-12 col-md-7">

            @* ---------------- Step 1: Shipping ---------------- *@
            <div class="checkout-step-panel" id="checkoutPanelShipping">
                <h4 class="mb-3">@Localizer["Shipping Information"]</h4>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="ShippingName" class="form-label"></label>
                    <input asp-for="ShippingName" class="form-control" />
                    <span asp-validation-for="ShippingName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ShippingAddress" class="form-label"></label>
                    <input asp-for="ShippingAddress" class="form-control" />
                    <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-5 mb-3">
                        <label asp-for="ShippingCity" class="form-label"></label>
                        <input asp-for="ShippingCity" class="form-control" />
                        <span asp-validation-for="ShippingCity" class="text-danger"></span>
                    </div>
                    <div class="col-6 col-sm-4 mb-3">
                        <label asp-for="ShippingState" class="form-label"></label>
                        <input asp-for="ShippingState" class="form-control" />
                        <span asp-validation-for="ShippingState" class="text-danger"></span>
                    </div>
                    <div class="col-6 col-sm-3 mb-3">
                        <label asp-for="ShippingZip" class="form-label"></label>
                        <input asp-for="ShippingZip" class="form-control" />
                        <span asp-validation-for="ShippingZip" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="ShippingPhone" class="form-label"></label>
                    <input asp-for="ShippingPhone" class="form-control" />
                    <span asp-validation-for="ShippingPhone" class="text-danger"></span>
                </div>
                @if (ViewBag.StripeConfigured != true)
                {
                    <div class="alert alert-warning">@Localizer["Stripe isn't configured yet. Add your Stripe test API keys to"] <code>appsettings.json</code> @Localizer["to enable checkout."]</div>
                }
                <p class="text-muted small"><i class="bi bi-shield-check"></i> @Localizer["We'll email you a one-time verification code, then you'll enter your card details right here."]</p>
                <div class="checkout-step-error" id="shippingError"></div>
                <button type="button" class="btn-wlm" id="shippingContinueBtn" @(ViewBag.StripeConfigured != true ? "disabled" : null)>
                    <i class="bi bi-shield-lock"></i> @Localizer["Send Verification Code"]
                </button>
            </div>

            @* ---------------- Step 2: Payment ---------------- *@
            <div class="checkout-step-panel d-none" id="checkoutPanelPayment">
                <h4 class="mb-3">@Localizer["Payment"]</h4>
                <p class="text-muted small"><i class="bi bi-lock-fill"></i> @Localizer["Your card details are entered directly into Stripe's secure form below — they never touch our servers."]</p>
                <div class="stripe-element-box">
                    <div id="stripe-payment-element"></div>
                </div>
                <div class="checkout-step-error" id="paymentError"></div>
                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn-wlm" id="paymentContinueBtn">@Localizer["Review Order"]</button>
                </div>
            </div>

            @* ---------------- Step 3: Review ---------------- *@
            <div class="checkout-step-panel d-none" id="checkoutPanelReview">
                <h4 class="mb-3">@Localizer["Review Your Order"]</h4>
                <div class="review-recap-box mb-3">
                    <h6>@Localizer["Shipping To"]</h6>
                    <div id="reviewShippingRecap" class="text-muted small"></div>
                </div>
                <p class="text-muted small"><i class="bi bi-credit-card"></i> @Localizer["You'll be charged using the card details entered in the previous step."]</p>
                <div class="checkout-step-error" id="reviewError"></div>
                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-outline-secondary" id="reviewBackBtn">@Localizer["Back"]</button>
                    <button type="button" class="btn-wlm" id="placeOrderBtn">@Localizer["Place Order"]</button>
                </div>
            </div>

        </div>
        <div class="col-12 col-md-5">
            <div class="summary-box">
                <h4>@Localizer["Order Summary"]</h4>
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span>
                            @item.Name &times; @item.Quantity
                            @if (!string.IsNullOrEmpty(item.Color) || !string.IsNullOrEmpty(item.Size))
                            {
                                <br /><small class="text-muted">@item.Color @(!string.IsNullOrEmpty(item.Color) && !string.IsNullOrEmpty(item.Size) ? " / " : "") @item.Size</small>
                            }
                        </span>
                        <span>@item.LineTotal.ToDisplayCurrency()</span>
                    </div>
                }
                <hr />

                <form asp-controller="Checkout" asp-action="@(Model.AppliedCouponCode != null ? "RemoveCoupon" : "ApplyCoupon")" method="post" class="mb-3">
                    @if (Model.AppliedCouponCode != null)
                    {
                        <div class="d-flex justify-content-between align-items-center coupon-applied-row">
                            <span><i class="bi bi-ticket-perforated"></i> @Localizer["Coupon"] <strong>@Model.AppliedCouponCode</strong> @Localizer["applied ({0}% off)", Model.CouponDiscountPercent.ToString("0.##")]</span>
                            <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Remove"]</button>
                        </div>
                    }
                    else
                    {
                        <label class="form-label small mb-1">@Localizer["Have a coupon code?"]</label>
                        <div class="d-flex gap-2">
                            <input type="text" name="couponCode" class="form-control" placeholder="e.g. WELCOME-AB12CD" />
                            <button type="submit" class="btn btn-outline-primary">@Localizer["Apply"]</button>
                        </div>
                    }
                </form>

                <hr />
                <div class="d-flex justify-content-between mb-2">
                    <span>@Localizer["Subtotal"]</span>
                    <span>@Model.Subtotal.ToDisplayCurrency()</span>
                </div>
                @if (Model.CouponDiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-2 coupon-discount-line">
                        <span>@Localizer["Coupon discount"]</span>
                        <span>&minus;@Model.CouponDiscountAmount.ToDisplayCurrency()</span>
                    </div>
                }
                <div class="d-flex justify-content-between mb-2">
                    <span>@Localizer["Shipping"]</span>
                    <span>@(Model.ShippingCost == 0 ? Localizer["Free"].Value : Model.ShippingCost.ToDisplayCurrency())</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between fw-bold">
                    <span>@Localizer["Total"]</span>
                    <span>@Model.Total.ToDisplayCurrency()</span>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---------------- OTP verification modal ---------------- *@
<div class="modal fade checkout-otp-modal" id="checkoutOtpModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">@Localizer["Verify Your Email"]</h5>
                    <div class="modal-subtitle">@Localizer["We sent a 6-digit code to"] <strong id="otpEmailLabel"></strong></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            </div>
            <div class="modal-body">
                <input type="text" inputmode="numeric" maxlength="6" autocomplete="one-time-code" class="form-control otp-code-input" id="otpCodeInput" placeholder="######" />
                <div class="checkout-step-error mt-2" id="otpError"></div>
                <button type="button" class="btn-wlm w-100 mt-3" id="otpVerifyBtn">@Localizer["Verify"]</button>
                <button type="button" class="btn btn-link w-100 mt-1" id="otpResendBtn">@Localizer["Resend Code"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        window.checkoutConfig = {
            sendOtpUrl: '@Url.Action("SendOtpAjax")',
            verifyOtpUrl: '@Url.Action("VerifyOtpAjax")',
            resendOtpUrl: '@Url.Action("ResendOtpAjax")',
            createPaymentIntentUrl: '@Url.Action("CreatePaymentIntent")',
            confirmOrderUrl: '@Url.Action("ConfirmOrder")',
            publishableKey: '@ViewBag.StripePublishableKey'
        };
    </script>
    <script src="~/js/checkout-wizard.js"></script>
}
