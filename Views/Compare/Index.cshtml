@using WorldLinkMaster.Web.Models
@model List<Product>
@{
    ViewData["Title"] = Localizer["Compare Products"];
    var isArabicUi = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";

    // Union of every attribute (excluding "FEATURE" marketing bullets — those belong on the
    // Description tab, not a spec comparison) across all compared products, so products with
    // completely different spec sets still line up — a row just shows "—" where a given
    // product has no value for that attribute.
    var attributeDefinitions = Model
        .SelectMany(p => p.AttributeValues)
        .Where(a => a.AttributeDefinition != null && a.AttributeDefinition.Code != "FEATURE")
        .Select(a => a.AttributeDefinition!)
        .GroupBy(a => a.Id)
        .Select(g => g.First())
        .OrderBy(a => a.NameEn)
        .ToList();
}

<div class="page-banner">
    <div class="container"><h1>@Localizer["Compare Products"]</h1></div>
</div>

<div class="container mb-5">
    @if (Model.Count == 0)
    {
        <div class="empty-favorites">
            <i class="bi bi-arrow-left-right"></i>
            <p class="mb-1">@Localizer["You haven't added any products to compare yet."]</p>
            <p class="text-muted">@Localizer["Browse products and tap \"Add to Compare\" to see them side by side here."]</p>
            <a class="btn-wlm" asp-controller="Products" asp-action="Index">@Localizer["All Products"]</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="compare-table">
                <thead>
                    <tr>
                        <th class="compare-row-label"></th>
                        @foreach (var product in Model)
                        {
                            <th class="compare-col">
                                <form asp-controller="Compare" asp-action="Remove" method="post" class="compare-remove-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit" class="compare-remove-btn" aria-label="@Localizer["Remove from comparison"]">&times;</button>
                                </form>
                                <a asp-controller="Products" asp-action="Details" asp-route-slug="@product.Slug">
                                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? ImagePlaceholder.DataUri : product.ImageUrl)" alt="@product.LocalizedName()" class="compare-image" />
                                    <span class="compare-name">@product.LocalizedName()</span>
                                </a>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th class="compare-row-label">@Localizer["Price"]</th>
                        @foreach (var product in Model)
                        {
                            <td>@product.Price.ToDisplayCurrency()</td>
                        }
                    </tr>
                    <tr>
                        <th class="compare-row-label">@Localizer["Rating"]</th>
                        @foreach (var product in Model)
                        {
                            <td>@product.Rating.ToString("0.0") (@product.ReviewCount)</td>
                        }
                    </tr>
                    <tr>
                        <th class="compare-row-label">@Localizer["Stock"]</th>
                        @foreach (var product in Model)
                        {
                            <td>
                                @if (product.StockQuantity > 0)
                                {
                                    <span class="text-success">@Localizer["In Stock"]</span>
                                }
                                else
                                {
                                    <span class="text-danger">@Localizer["Out of Stock"]</span>
                                }
                            </td>
                        }
                    </tr>
                    @foreach (var attrDef in attributeDefinitions)
                    {
                        <tr>
                            <th class="compare-row-label">@(isArabicUi ? (attrDef.NameAr ?? attrDef.NameEn) : attrDef.NameEn)</th>
                            @foreach (var product in Model)
                            {
                                var value = product.AttributeValues.FirstOrDefault(a => a.AttributeDefinitionId == attrDef.Id);
                                <td>@(value == null ? "—" : (isArabicUi && !string.IsNullOrWhiteSpace(value.ValueAr) ? value.ValueAr : value.ValueEn))</td>
                            }
                        </tr>
                    }
                    <tr>
                        <th class="compare-row-label"></th>
                        @foreach (var product in Model)
                        {
                            <td><a class="btn-wlm" asp-controller="Products" asp-action="Details" asp-route-slug="@product.Slug">@Localizer["View Product"]</a></td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>
