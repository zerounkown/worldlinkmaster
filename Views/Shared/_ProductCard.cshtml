@using WorldLinkMaster.Web.Models
@using WorldLinkMaster.Web.Extensions
@using WorldLinkMaster.Web.Services
@using System.Text.Json
@inject IFavoriteService FavoriteService
@model Product
@{
    var activeEvent = ViewBag.ActiveEvent as PromoEvent;
    var salePrice = activeEvent != null ? Model.Price * (1 - activeEvent.DiscountPercent / 100m) : (decimal?)null;
    var hasVariants = Model.Variants.Count > 0;
    var isFavorite = User.Identity?.IsAuthenticated == true && await FavoriteService.IsFavoriteAsync(Model.Id);
    var cardImageUrl = string.IsNullOrEmpty(Model.ImageUrl) ? ImagePlaceholder.DataUri : Model.ImageUrl;
    var hoverImageUrl = Model.GetHoverImageUrl(cardImageUrl);

    // Hoisted out of the quick-add-only block below (still reused there) so swatches can gate on
    // "2+ colors" independently of hasVariants — a product can have variants (sizes) without
    // having 2+ colors. Same zero-extra-query data every card already carries via the
    // Variants→Color/ProductColor includes the controller already runs for the quick-add modal.
    var defaultCardColorId = Model.ProductColors.FirstOrDefault(pc => pc.DefaultColor)?.ColorId
        ?? Model.ProductColors.FirstOrDefault()?.ColorId;
    var cardColors = Model.Variants
        .Where(v => v.Color != null)
        .GroupBy(v => v.ColorId)
        .Select(g => new
        {
            name = g.First().Color!.Name,
            hex = g.First().Color!.HexCode,
            image = ImagePlaceholder.IsRealImageUrl(g.First().ProductColor?.SwatchImageUrl) ? g.First().ProductColor!.SwatchImageUrl : null,
            isDefault = g.Key == defaultCardColorId
        })
        // Default color first so it's never cut off by Take(6) on a product with 7+ colors —
        // its ring needs to actually be visible on load, not just theoretically present in data.
        .OrderByDescending(c => c.isDefault)
        .ToList();
    var visibleSwatchColors = cardColors.Take(6).ToList();
    var extraSwatchCount = cardColors.Count - visibleSwatchColors.Count;

    string quickAddJson = "null";
    if (hasVariants)
    {
        var colors = cardColors;

        var sizes = Model.Variants
            .Where(v => v.Size != null)
            .GroupBy(v => v.SizeId)
            .Select(g => new { label = g.First().Size!.Label, displayLabel = g.First().Size!.Label.ToDisplaySizeLabel() })
            .ToList();

        var variants = Model.Variants.Select(v =>
        {
            var basePriceForVariant = v.Price ?? Model.Price;
            var finalPrice = activeEvent != null
                ? basePriceForVariant * (1 - activeEvent.DiscountPercent / 100m)
                : basePriceForVariant;

            return new
            {
                color = v.Color?.Name,
                size = v.Size?.Label,
                // Raw per-unit values (view's own display currency, unformatted) so the modal
                // can compute a quantity total client-side instead of parsing formatted text —
                // same pattern as the PDP's data-unit-price/data-currency-symbol total line.
                price = finalPrice.ToDisplayCurrencyValue(),
                listPrice = activeEvent != null ? basePriceForVariant.ToDisplayCurrencyValue() : (decimal?)null,
                priceFormatted = finalPrice.ToDisplayCurrency(),
                listPriceFormatted = activeEvent != null ? basePriceForVariant.ToDisplayCurrency() : null,
                stock = v.StockQuantity,
                active = v.Active
            };
        }).ToList();

        var quickAddData = new
        {
            id = Model.Id,
            name = Model.LocalizedName(),
            currencySymbol = CurrencyContext.Current == "USD" ? "$" : "AED ",
            colors,
            sizes,
            variants
        };

        quickAddJson = JsonSerializer.Serialize(quickAddData, new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
    }
}

<div class="product-card">
    <div class="product-card-media">
        @if (activeEvent != null)
        {
            <span class="sale-badge">@activeEvent.DiscountPercent.ToString("0.##")% @Localizer["OFF"]</span>
        }
        else if (Model.IsFeatured)
        {
            <span class="featured-badge">@Localizer["Featured"]</span>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button type="button" class="favorite-toggle js-favorite-toggle @(isFavorite ? "active" : "")" data-product-id="@Model.Id"
                    aria-label="@Localizer["Add to Favorites"]" aria-pressed="@(isFavorite ? "true" : "false")">
                <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart")"></i>
            </button>
        }
        else
        {
            <a class="favorite-toggle" asp-area="Identity" asp-page="/Account/Login" aria-label="@Localizer["Add to Favorites"]">
                <i class="bi bi-heart"></i>
            </a>
        }
        <a class="product-card-tilt product-card-link @(hoverImageUrl != null ? "has-hover-image" : "")" asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug">
            <img src="@cardImageUrl" alt="@Model.LocalizedName()" class="card-product-image" data-default-image="@cardImageUrl" />
            @if (hoverImageUrl != null)
            {
                <img src="@hoverImageUrl" alt="" class="card-product-image card-product-image-hover" aria-hidden="true" loading="lazy" />
            }
        </a>
    </div>
    <div class="product-card-body">
        <h3><a class="product-card-link" asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug">@Model.LocalizedName()</a></h3>

        <div class="product-card-price-row">
            @if (salePrice.HasValue)
            {
                <span class="price-was">@Model.Price.ToDisplayCurrency()</span>
                <span class="price price-sale">@salePrice.Value.ToDisplayCurrency()</span>
            }
            else
            {
                <span class="price">@Model.Price.ToDisplayCurrency()</span>
            }
        </div>

        @* Always rendered (even empty) so card heights stay aligned in the grid regardless of
           whether this product has 2+ colors — see .product-card-swatches min-height in site.css. *@
        <div class="product-card-swatches">
            @if (visibleSwatchColors.Count > 1)
            {
                @foreach (var color in visibleSwatchColors)
                {
                    <button type="button" class="product-card-swatch @(color.isDefault ? "active" : "")" style="--swatch-color: @color.hex"
                            data-color="@color.name" data-image="@color.image" data-default="@(color.isDefault ? "1" : null)"
                            aria-label="@color.name" title="@color.name"></button>
                }
                @if (extraSwatchCount > 0)
                {
                    <span class="product-card-swatch-more">+@extraSwatchCount</span>
                }
            }
        </div>

        @if (Model.StockQuantity > 0)
        {
            @if (hasVariants)
            {
                <button type="button" class="product-card-add-btn js-quick-add" data-product='@Html.Raw(quickAddJson)'>
                    @Localizer["Add to Cart"]
                </button>
            }
            else
            {
                <button type="button" class="product-card-add-btn js-inline-add" data-product-id="@Model.Id" data-product-name="@Model.Name">
                    @Localizer["Add to Cart"]
                </button>
            }
        }
        else
        {
            <button type="button" class="product-card-add-btn" disabled>@Localizer["Out of Stock"]</button>
        }
    </div>
</div>
