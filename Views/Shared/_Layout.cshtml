@using System.Globalization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using WorldLinkMaster.Web.Data
@using WorldLinkMaster.Web.Extensions
@using WorldLinkMaster.Web.Services
@using Microsoft.Extensions.Configuration
@inject ApplicationDbContext DbContext
@inject ICartService CartService
@inject IFavoriteService FavoriteService
@inject ICompareService CompareService
@inject ICouponService CouponService
@inject IConfiguration Configuration
@{
    Coupon? newWelcomeCoupon = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!string.IsNullOrEmpty(currentUserId))
        {
            newWelcomeCoupon = await CouponService.EnsureWelcomeCouponAsync(currentUserId);
        }
    }
    var navCategories = await DbContext.Categories.Include(c => c.Subcategories.OrderBy(s => s.Name)).OrderBy(c => c.Name).ToListAsync();

    // Short one-line promo captions for each category dropdown's image panel — same convention as
    // Welcome.cshtml's collectionsTagBySlug (decorative marketing copy, not core category data,
    // so a small slug-keyed dictionary here beats a new database field). Always English, matching
    // the same "reference design" choice collectionsTagBySlug already made for its own tags.
    var megaMenuPromoCaptionBySlug = new Dictionary<string, string>
    {
        ["bags-and-packs"] = "Rugged, mission-ready packs for every load.",
        ["tactical-apparel"] = "Field-tested apparel built to move with you.",
        ["footwear"] = "Boots and shoes engineered for the long haul.",
        ["gear-and-accessories"] = "Everyday carry essentials for any mission.",
        ["outdoor-equipment"] = "Camp and field gear that goes the distance."
    };
    // Shortened nav-bar labels vs. the full category name (e.g. "Tactical Apparel" -> "Apparel"),
    // matching the reference header's nav text. Falls back to the full localized name for any
    // category not listed here.
    var navLabelBySlug = new Dictionary<string, string>
    {
        ["tactical-apparel"] = "Apparel",
        ["bags-and-packs"] = "Bags & Packs"
    };
    // Explicit nav display order (not alphabetical) matching the reference header. Categories not
    // in this list (future additions) sort after the listed ones, alphabetically among themselves.
    var navDisplayOrder = new List<string> { "tactical-apparel", "footwear", "bags-and-packs", "gear-and-accessories", "outdoor-equipment" };
    var orderedNavCategories = navCategories
        .OrderBy(c => { var i = navDisplayOrder.IndexOf(c.Slug); return i < 0 ? int.MaxValue : i; })
        .ThenBy(c => c.Name)
        .ToList();

    // Full-width mega-menu column groupings — hand-curated per category (there's no "column"
    // field on Subcategory) since the real taxonomy doesn't come pre-grouped. Keyed by
    // subcategory slug rather than name so it stays stable across localization. Any subcategory
    // not listed here (a future addition nobody updated this map for) lands in an automatic
    // "More" column instead of silently vanishing from the nav.
    var megaMenuColumnsBySlug = new Dictionary<string, (string Header, string[] Slugs)[]>
    {
        ["tactical-apparel"] = new (string Header, string[] Slugs)[]
        {
            ("Tops", new[] { "t-shirts", "combat-shirts", "combat-shirt", "short-sleeve-t-shirt", "long-sleeve-t-shirt", "short-sleeve-crew-neck-t-shirt", "long-sleeve-crew-neck-t-shirt", "general-apparel" }),
            ("Bottoms", new[] { "tactical-pants", "tactical-shorts", "tactical-trousers" }),
            ("Outerwear", new[] { "tactical-jackets", "tactical-vests-plate-carriers" }),
            ("Base Layers", new[] { "thermal-base-layers", "base-layer-underwear" })
        },
        ["footwear"] = new (string Header, string[] Slugs)[]
        {
            ("Boots", new[] { "tactical-boots", "black-tactical-boots", "low-cut-black-tactical-boots", "desert-tactical-boots-beige", "low-cut-desert-tactical-boots-beige" }),
            ("Work & Safety", new[] { "safety-shoes", "formal-duty-shoes" }),
            ("Active & Outdoor", new[] { "sports-shoes", "hiking-shoes" }),
            ("All Footwear", new[] { "footwear", "general-footwear" })
        },
        ["bags-and-packs"] = new (string Header, string[] Slugs)[]
        {
            ("Everyday Carry", new[] { "backpacks", "shoulder-bags", "waist-packs" }),
            ("Travel", new[] { "trolley-bags", "duffel-bags" }),
            ("Specialty", new[] { "laptop-bags", "weapon-bags" }),
            ("All Bags", new[] { "bags-packs", "general-bags" })
        },
        ["gear-and-accessories"] = new (string Header, string[] Slugs)[]
        {
            ("Wearables", new[] { "tactical-gloves", "tactical-socks", "tactical-caps", "tactical-belts", "tactical-watches", "accessories", "general-gear" }),
            ("Protection", new[] { "tactical-helmets", "tactical-eyewear", "face-masks-balaclavas", "first-aid-kits" }),
            ("Tools & Blades", new[] { "tactical-knives", "multi-tools-leatherman-tools", "tactical-baton", "entrenching-tools", "military-folding-shovel" }),
            ("Optics & Comms", new[] { "optics-binoculars", "tactical-flashlights", "tactical-compass" }),
            ("Carry & Storage", new[] { "holsters", "magazines", "weapon-cases", "tool-bags", "weapon-cleaning-kits" }),
            ("Field Essentials", new[] { "morale-patches", "national-service-gear", "towels-towelettes", "camouflage-tape", "military-canteen" })
        }
    };

    List<(string Header, List<Subcategory> Items)> BuildMegaColumns(Category category)
    {
        var spec = megaMenuColumnsBySlug.GetValueOrDefault(category.Slug) ?? Array.Empty<(string Header, string[] Slugs)>();
        var bySlug = category.Subcategories.ToDictionary(s => s.Slug);
        var used = new HashSet<int>();
        var columns = new List<(string, List<Subcategory>)>();
        foreach (var (header, slugs) in spec)
        {
            var items = new List<Subcategory>();
            foreach (var slug in slugs)
            {
                if (bySlug.TryGetValue(slug, out var sub))
                {
                    items.Add(sub);
                    used.Add(sub.Id);
                }
            }
            if (items.Count > 0)
            {
                columns.Add((header, items));
            }
        }
        var leftovers = category.Subcategories.Where(s => !used.Contains(s.Id)).ToList();
        if (leftovers.Count > 0)
        {
            columns.Add(("More", leftovers));
        }
        return columns;
    }

    // Mega-menu sub-filter chips (brand / neck type / sleeve length / pants type) — one query for
    // every subcategory that carries them, grouped in memory below, rather than a query per
    // subcategory. Reads whatever real values exist; with none seeded yet (see
    // Scripts/MockApparelAttributeSeeder.cs) every group below comes back empty and no chips
    // render at all — this is intentionally safe to ship before real data exists.
    var tShirtFamilySlugs = new HashSet<string> { "t-shirts", "combat-shirts", "combat-shirt", "short-sleeve-t-shirt", "long-sleeve-t-shirt", "short-sleeve-crew-neck-t-shirt", "long-sleeve-crew-neck-t-shirt" };
    var pantsFamilySlugs = new HashSet<string> { "tactical-pants", "tactical-shorts", "tactical-trousers" };
    var quickFilterSlugs = tShirtFamilySlugs.Concat(pantsFamilySlugs).ToArray();

    var quickFilterProducts = await DbContext.Products
        .Where(p => p.Subcategory != null && quickFilterSlugs.Contains(p.Subcategory.Slug))
        .Include(p => p.Subcategory)
        .Include(p => p.Brand)
        .Include(p => p.AttributeValues.Where(a => a.Active)).ThenInclude(a => a.AttributeDefinition)
        .AsSplitQuery()
        .ToListAsync();

    const int QuickFilterCapPerGroup = 3;

    var quickFiltersBySubSlug = quickFilterProducts
        .GroupBy(p => p.Subcategory!.Slug)
        .ToDictionary(g => g.Key, g => new
        {
            Brands = g.Where(p => p.Brand != null).Select(p => p.Brand!).DistinctBy(b => b.Id).OrderBy(b => b.Name).Take(QuickFilterCapPerGroup).ToList(),
            NeckTypes = g.SelectMany(p => p.AttributeValues.Where(a => a.AttributeDefinition?.Code == "NECK_TYPE")).Select(a => a.ValueEn).Distinct().OrderBy(v => v).Take(QuickFilterCapPerGroup).ToList(),
            SleeveLengths = g.SelectMany(p => p.AttributeValues.Where(a => a.AttributeDefinition?.Code == "SLEEVE_LENGTH")).Select(a => a.ValueEn).Distinct().OrderBy(v => v).Take(QuickFilterCapPerGroup).ToList(),
            PantsTypes = g.SelectMany(p => p.AttributeValues.Where(a => a.AttributeDefinition?.Code == "PANTS_TYPE")).Select(a => a.ValueEn).Distinct().OrderBy(v => v).Take(QuickFilterCapPerGroup).ToList()
        });

    // Renders as a flat (label, href, isBrand) list so the view doesn't need to know brand vs.
    // attribute shape — brand chips route through the real brandIds facet, attribute chips
    // through the generic attr=Code:Value one added to ProductsController.Index. IsBrand drives a
    // small visual distinction (see .main-nav-mega-subfilter-chip-brand) so a dense row of chips
    // still reads as "these are brands, these are specs" rather than one undifferentiated wall.
    List<(string Label, string Href, bool IsBrand)> BuildQuickFilters(Category category, Subcategory subcategory)
    {
        var result = new List<(string, string, bool)>();
        if (!quickFiltersBySubSlug.TryGetValue(subcategory.Slug, out var qf))
        {
            return result;
        }

        foreach (var brand in qf.Brands)
        {
            result.Add((brand.Name, Url.Action("Index", "Products", new { categoryId = category.Id, subcategoryId = subcategory.Id, brandIds = brand.Id })!, true));
        }

        void AddAttrChips(IEnumerable<string> values, string code)
        {
            foreach (var value in values)
            {
                result.Add((value, Url.Action("Index", "Products", new { categoryId = category.Id, subcategoryId = subcategory.Id, attr = $"{code}:{value}" })!, false));
            }
        }

        AddAttrChips(qf.NeckTypes, "NECK_TYPE");
        AddAttrChips(qf.SleeveLengths, "SLEEVE_LENGTH");
        AddAttrChips(qf.PantsTypes, "PANTS_TYPE");

        return result;
    }

    var categoryPreviews = new Dictionary<int, List<Product>>();
    foreach (var navCategory in navCategories)
    {
        categoryPreviews[navCategory.Id] = await DbContext.Products
            .Where(p => p.CategoryId == navCategory.Id && p.StockQuantity > 0)
            .OrderByDescending(p => p.IsFeatured)
            .ThenByDescending(p => p.Id)
            .Take(4)
            .ToListAsync();
    }
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = currentCulture == "ar";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isHomeActive = currentController == "Home" && currentAction == "Welcome";
    var isNewArrivalsActive = currentController == "Products" && currentAction == "NewArrivals";
    var isContactActive = currentController == "Home" && currentAction == "Contact";
    var isLocationsActive = currentController == "Home" && currentAction == "Locations";
    var isTradeProgramActive = currentController == "Wholesale";
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["World Link Master"]</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/site-rtl.css" asp-append-version="true" />
    }
</head>
<body>
    <div class="site-header-sticky">
    <div class="topbar">
        <div class="container topbar-inner">
            <div class="topbar-left">
                <span><i class="bi bi-truck"></i> @Localizer["Free shipping on orders over AED 365"]</span>
                <a class="topbar-link @(isContactActive ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Contact">@Localizer["Contact Us"]</a>
                <a class="topbar-link @(isLocationsActive ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Locations">@Localizer["Find a Store"]</a>
                <a class="topbar-link @(isTradeProgramActive ? "active" : "")" asp-area="" asp-controller="Wholesale" asp-action="Apply">@Localizer["Trade Program"]</a>
                <a class="topbar-link" asp-area="" asp-controller="Products" asp-action="Sales">@Localizer["Sales"]</a>
            </div>
            <div class="topbar-right">
                <a class="topbar-quote-link" asp-area="" asp-controller="QuoteRequests" asp-action="Create" aria-label="@Localizer["Bulk Pricing / Request a Quote"]"><i class="bi bi-file-earmark-text"></i> <span>@Localizer["Bulk Pricing / Request a Quote"]</span></a>
                <span class="topbar-contact"><i class="bi bi-telephone"></i> 1-800-555-0199</span>
            </div>
        </div>
    </div>

    <header class="site-header">
        <div class="container header-inner">
            <div class="header-branding">
                <button type="button" class="menu-toggle" id="sideNavToggle" aria-label="@Localizer["Open menu"]" aria-controls="sideNav" aria-expanded="false">
                    <i class="bi bi-list"></i>
                    <span>@Localizer["Menu"]</span>
                </button>
                <a class="brand brand-logo" asp-route="root">
                    <img src="~/images/logo.png" alt="World Link Masters" asp-append-version="true" />
                </a>
            </div>

            <form class="header-search-inline" asp-area="" asp-controller="Products" asp-action="Index" method="get">
                <input type="text" name="search" placeholder="@Localizer["SEARCH STORE..."]" aria-label="@Localizer["Search"]" />
                <button type="submit" aria-label="@Localizer["Search"]"><i class="bi bi-search"></i></button>
            </form>

            <div class="header-col header-col-end">
                <div class="header-actions">
                    <button type="button" class="search-toggle" id="headerSearchToggle" aria-expanded="false" aria-controls="headerSearchPanel" aria-label="@Localizer["Search"]">
                        <i class="bi bi-search"></i>
                    </button>
                    <div class="lang-switch">
                        <form asp-area="" asp-controller="Localization" asp-action="SetLanguage" method="post">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <input type="hidden" name="culture" value="en" />
                            <button type="submit" class="lang-switch-option @(!isRtl ? "active" : "")">EN</button>
                        </form>
                        <span class="lang-switch-divider">|</span>
                        <form asp-area="" asp-controller="Localization" asp-action="SetLanguage" method="post">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <input type="hidden" name="culture" value="ar" />
                            <button type="submit" class="lang-switch-option @(isRtl ? "active" : "")">AR</button>
                        </form>
                    </div>
                    <div class="currency-switch">
                        <button type="button" class="currency-switch-toggle" id="currencySwitchToggle" aria-expanded="false">
                            @WorldLinkMaster.Web.Services.CurrencyContext.Current <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="currency-switch-panel" id="currencySwitchPanel">
                            <form asp-area="" asp-controller="Currency" asp-action="SetCurrency" method="post">
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <input type="hidden" name="currency" value="AED" />
                                <button type="submit" class="@(WorldLinkMaster.Web.Services.CurrencyContext.Current == "AED" ? "active" : "")">AED — @Localizer["UAE Dirham"]</button>
                            </form>
                            <form asp-area="" asp-controller="Currency" asp-action="SetCurrency" method="post">
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <input type="hidden" name="currency" value="USD" />
                                <button type="submit" class="@(WorldLinkMaster.Web.Services.CurrencyContext.Current == "USD" ? "active" : "")">USD — @Localizer["US Dollar"]</button>
                            </form>
                        </div>
                    </div>
                    <partial name="_LoginPartial" />
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="favorites-link" asp-area="" asp-controller="Favorites" asp-action="Index" title="@Localizer["My Favorites"]">
                            <i class="bi bi-heart"></i>
                            <span class="favorites-label">@Localizer["Favorites"] (<span class="favorites-count">@await FavoriteService.GetCountAsync()</span>)</span>
                        </a>
                    }
                    else
                    {
                        <a class="favorites-link" asp-area="Identity" asp-page="/Account/Login" title="@Localizer["My Favorites"]">
                            <i class="bi bi-heart"></i>
                            <span class="favorites-label">@Localizer["Favorites"] (<span class="favorites-count">0</span>)</span>
                        </a>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="favorites-link" asp-area="" asp-controller="Compare" asp-action="Index" title="@Localizer["Compare"]">
                            <i class="bi bi-arrow-left-right"></i>
                            <span class="favorites-label">@Localizer["Compare"] (<span class="compare-count">@await CompareService.GetCountAsync()</span>)</span>
                        </a>
                    }
                    else
                    {
                        <a class="favorites-link" asp-area="Identity" asp-page="/Account/Login" title="@Localizer["Compare"]">
                            <i class="bi bi-arrow-left-right"></i>
                            <span class="favorites-label">@Localizer["Compare"] (<span class="compare-count">0</span>)</span>
                        </a>
                    }
                    <a class="cart-link" asp-area="" asp-controller="Cart" asp-action="Index">
                        <i class="bi bi-bag"></i>
                        <span class="cart-label">@Localizer["Cart"] (<span class="cart-count">@CartService.GetItemCount()</span>)</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <div class="header-search-panel" id="headerSearchPanel">
        <div class="container header-search-panel-inner">
            <div class="header-search-panel-top">
                <span>@Localizer["What are you looking for?"]</span>
                <button type="button" class="header-search-close" id="headerSearchClose" aria-label="@Localizer["Close"]">&times;</button>
            </div>
            <form class="header-search-form" asp-area="" asp-controller="Products" asp-action="Index" method="get">
                <input type="text" name="search" class="header-search-input" placeholder="@Localizer["Search products..."]" />
                <button type="submit" class="header-search-submit"><i class="bi bi-search"></i></button>
            </form>
        </div>
    </div>

    <nav class="main-nav">
        <div class="container main-nav-inner">
            <a class="main-nav-link @(isHomeActive ? "active" : "")" asp-route="root">@Localizer["Home"]</a>
            @foreach (var category in orderedNavCategories)
            {
                var isCategoryActive = currentController == "Products" && currentAction == "Index" && Context.Request.Query["categoryId"].ToString() == category.Id.ToString();
                var navLabel = navLabelBySlug.GetValueOrDefault(category.Slug, category.LocalizedName());
                var promoCaption = megaMenuPromoCaptionBySlug.GetValueOrDefault(category.Slug, category.LocalizedName());
                var promoHref = Url.Action("Index", "Products", new { categoryId = category.Id });
                var megaColumns = BuildMegaColumns(category);
                <div class="main-nav-item main-nav-dropdown">
                    <a class="main-nav-link @(isCategoryActive ? "active" : "")" asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id">@navLabel <i class="bi bi-chevron-down"></i></a>
                    <div class="main-nav-dropdown-panel main-nav-dropdown-panel-mega">
                        <div class="container main-nav-mega-inner">
                            <div class="main-nav-mega-top">
                                <a class="main-nav-mega-viewall" asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id">@Localizer["View All {0}", navLabel]</a>
                            </div>
                            <div class="main-nav-mega-body">
                                <div class="main-nav-mega-columns">
                                    @foreach (var column in megaColumns)
                                    {
                                        <div class="main-nav-mega-column">
                                            <h6 class="main-nav-mega-column-header">@column.Header</h6>
                                            @foreach (var subcategory in column.Items)
                                            {
                                                var subImage = string.IsNullOrWhiteSpace(subcategory.ImageUrl) ? category.ImageUrl : subcategory.ImageUrl;
                                                var subCaption = subcategory.LocalizedDescription();
                                                if (string.IsNullOrWhiteSpace(subCaption)) { subCaption = subcategory.LocalizedName(); }
                                                var subHref = Url.Action("Index", "Products", new { categoryId = category.Id, subcategoryId = subcategory.Id });
                                                var subQuickFilters = BuildQuickFilters(category, subcategory);
                                                <a class="main-nav-mega-subitem" asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id" asp-route-subcategoryId="@subcategory.Id"
                                                   data-promo-image="@subImage"
                                                   data-promo-caption="@subCaption"
                                                   data-promo-cta-text="@Localizer["Shop {0}", subcategory.LocalizedName()]"
                                                   data-promo-cta-href="@subHref">@subcategory.LocalizedName()</a>
                                                @if (subQuickFilters.Count > 0)
                                                {
                                                    <div class="main-nav-mega-subfilters">
                                                        @foreach (var chip in subQuickFilters)
                                                        {
                                                            <a class="main-nav-mega-subfilter-chip @(chip.IsBrand ? "main-nav-mega-subfilter-chip-brand" : "")" href="@chip.Href">@chip.Label</a>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="main-nav-mega-promo">
                                    <div class="main-nav-mega-promo-image-stack">
                                        <img class="js-mega-promo-image active" src="@category.ImageUrl" alt="" />
                                        <img class="js-mega-promo-image" src="@category.ImageUrl" alt="" />
                                    </div>
                                    <p class="js-mega-promo-caption">@promoCaption</p>
                                    <a class="main-nav-mega-promo-cta js-mega-promo-cta" href="@promoHref">
                                        <span class="js-mega-promo-cta-text">@Localizer["Shop {0}", navLabel]</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <a class="main-nav-link" asp-area="" asp-controller="Home" asp-action="Welcome" asp-fragment="shop-by-brand">@Localizer["Brands"]</a>
            <a class="main-nav-link @(isNewArrivalsActive ? "active" : "")" asp-area="" asp-controller="Products" asp-action="NewArrivals">@Localizer["New Arrival"]</a>
            @if (newWelcomeCoupon != null)
            {
                <a class="main-nav-link main-nav-link-coupon" asp-area="" asp-controller="Coupons" asp-action="Index">@Localizer["My Coupon"]</a>
            }
            <a class="main-nav-link main-nav-link-sale" asp-area="" asp-controller="Products" asp-action="Sales">@Localizer["Special Sales"]</a>
        </div>
    </nav>
    <div class="main-nav-mega-overlay" id="mainNavMegaOverlay"></div>
    </div>

    <div class="side-nav-overlay" id="sideNavOverlay"></div>
    <aside class="side-nav" id="sideNav" aria-hidden="true">
        <div class="side-nav-header">
            <span class="side-nav-title">@Localizer["Shop Categories"]</span>
            <button type="button" class="side-nav-close" id="sideNavClose" aria-label="@Localizer["Close menu"]">&times;</button>
        </div>
        <nav class="side-nav-links">
            @if (newWelcomeCoupon != null)
            {
                <a class="side-nav-link-coupon" asp-area="" asp-controller="Coupons" asp-action="Index"><i class="bi bi-gift"></i> @Localizer["My Coupon"]</a>
            }
            <a class="side-nav-link-sale" asp-area="" asp-controller="Products" asp-action="Sales"><i class="bi bi-fire"></i> @Localizer["Special Sales"]</a>
            <a asp-area="" asp-controller="Products" asp-action="Index"><i class="bi bi-grid"></i> @Localizer["All Products"]</a>
            @foreach (var category in navCategories)
            {
                var previewProducts = categoryPreviews.TryGetValue(category.Id, out var cp) ? cp : new List<Product>();
                var sideNavColumns = BuildMegaColumns(category);
                var hasSideNavPanel = previewProducts.Count > 0 || sideNavColumns.Count > 0;
                <div class="side-nav-item">
                    <a class="side-nav-link" asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id">@category.LocalizedName()</a>
                    @if (hasSideNavPanel)
                    {
                        <button type="button" class="side-nav-preview-toggle" aria-label="@Localizer["Browse {0}", category.LocalizedName()]" aria-expanded="false">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="category-preview-panel">
                            @if (sideNavColumns.Count > 0)
                            {
                                <div class="side-nav-subgroups">
                                    @foreach (var column in sideNavColumns)
                                    {
                                        <div class="side-nav-subgroup">
                                            <span class="side-nav-subgroup-header">@column.Header</span>
                                            <div class="side-nav-subgroup-links">
                                                @foreach (var subcategory in column.Items)
                                                {
                                                    <a asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id" asp-route-subcategoryId="@subcategory.Id">@subcategory.LocalizedName()</a>
                                                    @foreach (var chip in BuildQuickFilters(category, subcategory))
                                                    {
                                                        <a class="side-nav-subfilter-chip @(chip.IsBrand ? "side-nav-subfilter-chip-brand" : "")" href="@chip.Href">@chip.Label</a>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            @if (previewProducts.Count > 0)
                            {
                                <div class="category-preview-row">
                                    @foreach (var product in previewProducts)
                                    {
                                        <a class="category-preview-card" asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@product.Slug">
                                            <span class="category-preview-image-wrap">
                                                <img src="@product.ImageUrl" alt="@product.LocalizedName()" />
                                            </span>
                                            <span class="category-preview-name">@product.LocalizedName()</span>
                                            <span class="category-preview-price">@product.Price.ToDisplayCurrency()</span>
                                        </a>
                                    }
                                </div>
                            }
                            <a class="category-preview-viewall" asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id">
                                @Localizer["View all in {0}", category.LocalizedName()] <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    }
                </div>
            }
            <hr />
            <a asp-area="" asp-controller="Home" asp-action="About"><i class="bi bi-info-circle"></i> @Localizer["About"]</a>
            <a asp-area="" asp-controller="Home" asp-action="Contact"><i class="bi bi-envelope"></i> @Localizer["Contact"]</a>
            <a asp-area="" asp-controller="MerchantOnboarding" asp-action="Apply"><i class="bi bi-shop"></i> @Localizer["Sell on World Link Master"]</a>
            <a asp-area="" asp-controller="Wholesale" asp-action="Apply"><i class="bi bi-tag"></i> @Localizer["Trade / Wholesale Pricing"]</a>
        </nav>
    </aside>

    <main class="site-main">
        @RenderBody()
    </main>

    <div class="nav-fab-stack">
        <button type="button" class="nav-fab" id="navBackBtn" title="@Localizer["Go back"]" aria-label="@Localizer["Go back"]">
            <i class="bi bi-arrow-left"></i>
        </button>
        <button type="button" class="nav-fab" id="navForwardBtn" title="@Localizer["Go forward"]" aria-label="@Localizer["Go forward"]">
            <i class="bi bi-arrow-right"></i>
        </button>
        <button type="button" class="nav-fab nav-fab-top" id="scrollTopBtn" title="@Localizer["Scroll to top"]" aria-label="@Localizer["Scroll to top"]">
            <i class="bi bi-arrow-up"></i>
        </button>
    </div>

    <footer class="site-footer">
        <div class="container footer-top">
            <div class="footer-newsletter">
                <h5>@Localizer["Join the World Link Master List"]</h5>
                <p>@Localizer["Get first access to new gear drops and field reports."]</p>
                <form class="newsletter-form" onsubmit="return false;">
                    <input type="email" placeholder="@Localizer["Your email address"]" required />
                    <button type="submit">@Localizer["Subscribe"]</button>
                </form>
            </div>
        </div>
        <div class="container footer-columns">
            <div class="footer-col">
                <h6>@Localizer["Shop"]</h6>
                <ul>
                    @foreach (var category in navCategories)
                    {
                        <li><a asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id">@category.LocalizedName()</a></li>
                    }
                </ul>
            </div>
            <div class="footer-col">
                <h6>@Localizer["Company"]</h6>
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="About">@Localizer["About Us"]</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Contact">@Localizer["Contact"]</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Terms">@Localizer["Terms & Conditions"]</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="ReturnPolicy">@Localizer["Return & Refund Policy"]</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["Privacy Policy"]</a></li>
                    <li><a asp-area="" asp-controller="MerchantOnboarding" asp-action="Apply">@Localizer["Sell on World Link Master"]</a></li>
                    <li><a asp-area="" asp-controller="Wholesale" asp-action="Apply">@Localizer["Trade / Wholesale Pricing"]</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h6>@Localizer["Account"]</h6>
                <ul>
                    <li><a asp-area="" asp-controller="Orders" asp-action="Index">@Localizer["Order History"]</a></li>
                    <li><a asp-area="" asp-controller="Coupons" asp-action="Index">@Localizer["My Coupons"]</a></li>
                    <li><a asp-area="Identity" asp-page="/Account/Login">@Localizer["Sign In"]</a></li>
                    <li><a asp-area="Identity" asp-page="/Account/Register">@Localizer["Create Account"]</a></li>
                </ul>
            </div>
            @{
                var facebookUrl = Configuration["SocialLinks:Facebook"];
                var instagramUrl = Configuration["SocialLinks:Instagram"];
                var youtubeUrl = Configuration["SocialLinks:YouTube"];
                var hasSocialLinks = !string.IsNullOrWhiteSpace(facebookUrl)
                    || !string.IsNullOrWhiteSpace(instagramUrl)
                    || !string.IsNullOrWhiteSpace(youtubeUrl);
            }
            @if (hasSocialLinks)
            {
                <div class="footer-col">
                    <h6>@Localizer["Connect"]</h6>
                    <div class="footer-social">
                        @if (!string.IsNullOrWhiteSpace(facebookUrl))
                        {
                            <a href="@facebookUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-facebook"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(instagramUrl))
                        {
                            <a href="@instagramUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-instagram"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(youtubeUrl))
                        {
                            <a href="@youtubeUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-youtube"></i></a>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="container footer-payments">
            <span class="footer-payments-label">@Localizer["We Accept"]</span>
            <div class="footer-payments-icons">
                <img src="~/images/payments/visa.png" alt="Visa" />
                <img src="~/images/payments/mastercard.png" alt="Mastercard" />
                <img src="~/images/payments/apple-pay.jpg" alt="Apple Pay" />
                <img src="~/images/payments/tabby.png" alt="Tabby" />
                <img src="~/images/payments/tamara.png" alt="Tamara" />
            </div>
        </div>
        <div class="container footer-bottom">
            &copy; @DateTime.Now.Year @Localizer["World Link Master. All rights reserved."]
        </div>
    </footer>

    @{
        var showChatWidget = User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") && !User.IsInRole("Support");
        var showWhatsAppWidget = !User.IsInRole("Admin") && !User.IsInRole("Support");
    }
    @if (showChatWidget)
    {
        <partial name="_ChatWidget" />
    }
    @if (showWhatsAppWidget)
    {
        <partial name="_WhatsAppWidget" />
    }

    <partial name="_QuickAddModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/product-quick-add.js" asp-append-version="true"></script>
    <script src="~/js/delete-button.js" asp-append-version="true"></script>
    <script src="~/js/main-nav-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/currency-switch.js" asp-append-version="true"></script>
    <script src="~/js/header-search.js" asp-append-version="true"></script>
    <script src="~/js/sticky-header.js" asp-append-version="true"></script>
    @if (showChatWidget)
    {
        <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
        <script src="~/js/chat-widget.js" asp-append-version="true"></script>
    }
    @if (showWhatsAppWidget)
    {
        <script src="~/js/whatsapp-widget.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
