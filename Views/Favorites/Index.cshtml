@using WorldLinkMaster.Web.Models
@model List<Product>
@{
    ViewData["Title"] = Localizer["My Favorites"];
}

<div class="page-banner">
    <div class="container">
        <h1>@Localizer["My Favorites"]</h1>
    </div>
</div>

<div class="container mb-5">
    @if (Model.Count == 0)
    {
        <div class="empty-favorites">
            <i class="bi bi-heart"></i>
            <p class="mb-1">@Localizer["You haven't added any favorites yet."]</p>
            <p class="text-muted">@Localizer["Browse products and tap the heart icon to save them here."]</p>
            <a class="btn-wlm" asp-controller="Products" asp-action="Index">@Localizer["All Products"]</a>
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    }
</div>
