@using WorldLinkMaster.Web.Models
@model List<Store>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = Localizer["Find a Store"];
    var googleMapsApiKey = Configuration["GoogleMaps:ApiKey"];
    var storesJson = System.Text.Json.JsonSerializer.Serialize(Model.Select(s => new
    {
        id = s.Id,
        name = s.Name,
        categoryKey = s.Category.ToString(),
        category = s.Category == StoreCategory.OfficialStore ? Localizer["Official Store"].Value : Localizer["Authorized Dealer"].Value,
        address = s.Address,
        city = s.City,
        phone = s.Phone,
        whatsApp = s.WhatsAppNumber,
        website = s.Website,
        lat = s.Latitude,
        lng = s.Longitude
    }));
}

<div class="page-banner">
    <div class="container">
        <h1>@Localizer["Find a Store"]</h1>
        <p class="mb-0">@Localizer["Search by address or area to find the nearest showroom or authorized dealer."]</p>
    </div>
</div>

<div class="container mb-5">
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">@Localizer["No stores are listed yet. Please check back soon."]</div>
    }
    else if (string.IsNullOrWhiteSpace(googleMapsApiKey))
    {
        @* Interactive map isn't configured yet — fall back to a plain address list so store
           info is still available, matching what the old static Locations page always showed. *@
        <div class="locations-grid">
            @foreach (var store in Model)
            {
                <div class="location-card">
                    <span class="location-pickup-badge">
                        @(store.Category == StoreCategory.OfficialStore ? Localizer["Official Store"] : Localizer["Authorized Dealer"])
                    </span>
                    <h4><i class="bi bi-geo-alt"></i> @store.Name</h4>
                    <p>@store.Address@(string.IsNullOrWhiteSpace(store.City) ? "" : $", {store.City}")</p>
                    <div class="location-contact-actions">
                        @if (!string.IsNullOrWhiteSpace(store.Phone))
                        {
                            <a class="btn-wlm-outline" href="tel:@store.Phone.Replace(" ", "")"><i class="bi bi-telephone"></i> @store.Phone</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(store.WhatsAppNumber))
                        {
                            <a class="btn-wlm whatsapp-btn" href="https://wa.me/@store.WhatsAppNumber" target="_blank" rel="noopener noreferrer"><i class="bi bi-whatsapp"></i> @store.WhatsAppNumber</a>
                        }
                        <a class="btn-wlm-outline" href="https://www.google.com/maps/dir/?api=1&destination=@store.Latitude,@store.Longitude" target="_blank" rel="noopener noreferrer"><i class="bi bi-signpost-split"></i> @Localizer["Get directions"]</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="store-locator-search">
            <div class="store-locator-search-input">
                <i class="bi bi-geo-alt"></i>
                <input type="text" id="storeSearchInput" class="form-control" placeholder="@Localizer["Enter your address or area"]" />
            </div>
            <button type="button" id="storeSearchBtn" class="btn btn-dark" title="@Localizer["Search"]"><i class="bi bi-search"></i></button>
            <button type="button" id="storeLocateMeBtn" class="btn btn-outline-dark" title="@Localizer["Use my location"]">
                <i class="bi bi-crosshair"></i> @Localizer["Locate me"]
            </button>
        </div>

        <p class="store-locator-count mt-3 mb-2" id="storeResultCount"></p>

        <div class="store-locator-layout">
            <div class="store-locator-results" id="storeResultsList">
                <p class="text-muted small">@Localizer["Search an address or use \"Locate me\" to see stores sorted by distance."]</p>
            </div>
            <div class="store-locator-map">
                <div id="storeLocatorMap"></div>
            </div>
        </div>

        <div class="d-none">
            <div id="storeCardTemplate">
                <div class="store-result-card">
                    <span class="store-category-badge"></span>
                    <h4 class="store-name"></h4>
                    <p class="store-distance"><i class="bi bi-signpost-2"></i> <span></span></p>
                    <p class="store-address"><i class="bi bi-geo-alt"></i> <span></span></p>
                    <p class="store-phone"><i class="bi bi-telephone"></i> <a href="#"></a></p>
                    <p class="store-website d-none"><i class="bi bi-globe"></i> <a href="#" target="_blank" rel="noopener noreferrer"></a></p>
                    <a class="btn btn-outline-dark btn-sm store-directions-btn" href="#" target="_blank" rel="noopener noreferrer">
                        <i class="bi bi-signpost-split"></i> @Localizer["Get directions"]
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Count > 0 && !string.IsNullOrWhiteSpace(googleMapsApiKey))
{
    @section Scripts {
        <script>
            window.storeLocatorData = {
                stores: @Html.Raw(storesJson),
                youAreHereLabel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["You are here"].Value)),
                getDirectionsLabel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Get directions"].Value)),
                resultCountLabel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Search results: {0}"].Value)),
                noAddressFoundLabel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Couldn't find that address. Please try a different search."].Value)),
                geolocationDeniedLabel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Couldn't get your location. Please search by address instead."].Value))
            };
        </script>
        <script src="~/js/store-locator.js" asp-append-version="true"></script>
        <script src="https://maps.googleapis.com/maps/api/js?key=@googleMapsApiKey&libraries=places&callback=initStoreLocatorMap" async defer></script>
    }
}
