@using WorldLinkMaster.Web.Models
@model Order
@{
    ViewData["Title"] = Localizer["Order #{0}", Model.Id];
    var stageOrder = new[] { OrderStatus.Pending, OrderStatus.Processing, OrderStatus.Shipped, OrderStatus.OutForDelivery, OrderStatus.Delivered };
    var stageLabels = new[] { "Order Placed", "Processing", "Shipped", "Out for Delivery", "Delivered" };
    var currentStageIndex = Array.IndexOf(stageOrder, Model.Status);
}

<div class="page-banner">
    <div class="container"><h1>@Localizer["Order #{0}", Model.Id]</h1></div>
</div>

<div class="container mb-5">
    <p><span class="badge-status badge-status-@Model.Status.ToString().ToLower()">@Localizer[Model.Status.ToString()]</span> &middot; @Localizer["Placed {0}", Model.OrderDate.ToLocalTime().ToString("MMM d, yyyy")]</p>

    <ol class="checkout-stepper order-tracking-stepper mb-4">
        @for (int i = 0; i < stageOrder.Length; i++)
        {
            // The last stage (Delivered) has nothing after it to be "in progress" toward, so once
            // it's the current status the whole timeline reads as complete rather than leaving the
            // final circle showing a bare step number.
            var isLastStage = i == stageOrder.Length - 1;
            var cls = (i < currentStageIndex || (isLastStage && i == currentStageIndex))
                ? "completed"
                : (i == currentStageIndex ? "active" : "");
            DateTime? stepDate = i == 0 ? Model.OrderDate : i == 2 ? Model.ShippedAt : i == 4 ? Model.DeliveredAt : null;
            <li class="checkout-step @cls">
                <span class="checkout-step-num">
                    @if (cls == "completed")
                    {
                        <i class="bi bi-check-lg"></i>
                    }
                    else
                    {
                        @(i + 1)
                    }
                </span>
                @Localizer[stageLabels[i]]
                @if (stepDate.HasValue)
                {
                    <span class="order-tracking-step-date">@stepDate.Value.ToLocalTime().ToString("MMM d, yyyy")</span>
                }
            </li>
        }
    </ol>

    @if (!string.IsNullOrEmpty(Model.TrackingUrl))
    {
        <div class="order-tracking-box mb-4">
            <div>
                <i class="bi bi-truck"></i>
                <span><strong>@(string.IsNullOrEmpty(Model.Carrier) ? "FedEx" : Model.Carrier) &mdash; @Model.TrackingNumber</strong></span>
            </div>
            <a href="@Model.TrackingUrl" target="_blank" rel="noopener noreferrer" class="btn-wlm-outline-dark">
                @Localizer["Track on FedEx"] <i class="bi bi-box-arrow-up-right"></i>
            </a>
        </div>
    }

    <div class="row">
        <div class="col-12 col-md-7">
            <div class="table-responsive">
            <table class="table">
                <thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Options"]</th><th>@Localizer["Price"]</th><th>@Localizer["Qty"]</th><th>@Localizer["Total"]</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td class="text-muted small">@item.Color @(!string.IsNullOrEmpty(item.Color) && !string.IsNullOrEmpty(item.Size) ? " / " : "") @item.Size</td>
                            <td>@item.UnitPrice.ToDisplayCurrency()</td>
                            <td>@item.Quantity</td>
                            <td>@item.LineTotal.ToDisplayCurrency()</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
        <div class="col-12 col-md-5">
            <div class="summary-box">
                <h4>@Localizer["Summary"]</h4>
                <div class="d-flex justify-content-between mb-2"><span>@Localizer["Subtotal"]</span><span>@Model.Subtotal.ToDisplayCurrency()</span></div>
                <div class="d-flex justify-content-between mb-2"><span>@Localizer["Shipping"]</span><span>@(Model.ShippingCost == 0 ? Localizer["Free"].Value : Model.ShippingCost.ToDisplayCurrency())</span></div>
                <hr />
                <div class="d-flex justify-content-between fw-bold"><span>@Localizer["Total"]</span><span>@Model.Total.ToDisplayCurrency()</span></div>
                <hr />
                <p class="mb-0">@Localizer["Shipping to:"]<br />@Model.ShippingName<br />@Model.ShippingAddress<br />@Model.ShippingCity, @Model.ShippingState @Model.ShippingZip</p>
            </div>
        </div>
    </div>
    <a class="mt-3 d-inline-block" asp-action="Index">&larr; @Localizer["Back to My Orders"]</a>
</div>
